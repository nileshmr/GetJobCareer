
---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
  title="Advertise & Collaborate | JobPortal"
  description="Partner with JobPortal to promote your brand, jobs, products, services, or hiring opportunities to students and early-career professionals across India."
>

  <!-- HERO -->
  <section class="advertise-hero">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>

    <div class="hero-content">
      <span class="badge">
        <span class="badge-dot"></span>
        Let's work together
      </span>

      <h1>
        Grow your brand with
        <span>JobPortal</span>
      </h1>

      <p>
        Reach students, freshers and early-career professionals across India.
        Partner with us to promote your brand, hiring opportunities, products,
        services or career programs.
      </p>

      <a href="#contact" class="hero-button">
        Start a Collaboration
        <span>→</span>
      </a>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-wrapper">
    <div class="stats">
      <div class="stat-card">
        <strong>12K+</strong>
        <span>Students & Job Seekers</span>
      </div>

      <div class="stat-card">
        <strong>5K+</strong>
        <span>Job Opportunities</span>
      </div>

      <div class="stat-card">
        <strong>300+</strong>
        <span>Companies & Employers</span>
      </div>

      <div class="stat-card">
        <strong>India</strong>
        <span>Audience Reach</span>
      </div>
    </div>
  </section>

  <!-- WHY COLLABORATE -->
  <section class="section">
    <div class="section-title">
      <h2>Why Partner With Us?</h2>
      <p>
        Connect your brand with an audience actively looking for career
        opportunities and professional growth.
      </p>
    </div>

    <div class="benefits-grid">

      <article class="benefit-card">
        <div class="benefit-icon">🎯</div>
        <h3>Targeted Audience</h3>
        <p>
          Reach students, freshers, developers and early-career professionals
          who are actively exploring jobs and career opportunities.
        </p>
      </article>

      <article class="benefit-card">
        <div class="benefit-icon">📢</div>
        <h3>Brand Promotion</h3>
        <p>
          Promote your company, product, service, event or career program
          directly to a relevant audience.
        </p>
      </article>

      <article class="benefit-card">
        <div class="benefit-icon">💼</div>
        <h3>Hiring Partnerships</h3>
        <p>
          Showcase your job openings and connect with candidates looking for
          internships and entry-level opportunities.
        </p>
      </article>

      <article class="benefit-card">
        <div class="benefit-icon">🤝</div>
        <h3>Long-Term Collaboration</h3>
        <p>
          We are open to long-term partnerships with companies, startups,
          educational platforms and career-focused brands.
        </p>
      </article>

      <article class="benefit-card">
        <div class="benefit-icon">🚀</div>
        <h3>Career-Focused Platform</h3>
        <p>
          Your brand appears in an environment focused on jobs, internships,
          skills and professional development.
        </p>
      </article>

      <article class="benefit-card">
        <div class="benefit-icon">📈</div>
        <h3>Grow Your Reach</h3>
        <p>
          Use our platform to increase awareness and reach people who are
          actively interested in career-related products and services.
        </p>
      </article>

    </div>
  </section>

  <!-- COLLABORATION OPTIONS -->
  <section class="options-section">
    <div class="section-title">
      <h2>What Can We Collaborate On?</h2>
      <p>Choose the type of partnership that best fits your goal.</p>
    </div>

    <div class="options-grid">

      <article class="option-card">
        <span class="option-number">01</span>
        <div>
          <h3>Sponsored Job Listings</h3>
          <p>
            Promote your company's job or internship opportunities and reach
            relevant candidates.
          </p>
        </div>
      </article>

      <article class="option-card">
        <span class="option-number">02</span>
        <div>
          <h3>Brand Advertising</h3>
          <p>
            Promote your company, product, app, website or career service to
            our audience.
          </p>
        </div>
      </article>

      <article class="option-card">
        <span class="option-number">03</span>
        <div>
          <h3>College & Coaching Collaboration</h3>
          <p>
            Partner with us to promote courses, training programs, workshops
            and career initiatives.
          </p>
        </div>
      </article>

      <article class="option-card">
        <span class="option-number">04</span>
        <div>
          <h3>Event Promotion</h3>
          <p>
            Promote hackathons, webinars, career fairs, workshops and other
            professional events.
          </p>
        </div>
      </article>

      <article class="option-card">
        <span class="option-number">05</span>
        <div>
          <h3>Career Partnerships</h3>
          <p>
            Work with us on initiatives designed to help students and
            professionals build their careers.
          </p>
        </div>
      </article>

      <article class="option-card">
        <span class="option-number">06</span>
        <div>
          <h3>Custom Partnerships</h3>
          <p>
            Have another idea? Tell us what you have in mind and we can
            discuss a customized collaboration.
          </p>
        </div>
      </article>

    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact-section" id="contact">
    <div class="contact-container">

      <div class="contact-info">
        <span class="small-label">PARTNER WITH US</span>

        <h2>
          Have an idea for a
          <span>collaboration?</span>
        </h2>

        <p>
          Tell us about your company, campaign or partnership idea. Our team
          will get back to you with the next steps.
        </p>

        <div class="contact-points">
          <div class="contact-point">
            <div class="contact-icon">✉</div>
            <div>
              <strong>Email</strong>
              <span>partnerships@jobportal.com</span>
            </div>
          </div>

          <div class="contact-point">
            <div class="contact-icon">🤝</div>
            <div>
              <strong>Partnerships</strong>
              <span>Advertising & Collaboration</span>
            </div>
          </div>

          <div class="contact-point">
            <div class="contact-icon">🇮🇳</div>
            <div>
              <strong>Audience</strong>
              <span>Students & professionals across India</span>
            </div>
          </div>
        </div>
      </div>

      <div class="contact-form-wrapper">
       <form class="contact-form" id="collaboration-form">

          <div class="form-row">

            <div class="form-group">
              <label for="name">Your Name</label>
              <input
                id="name"
                name="Name"
                type="text"
                placeholder="Enter your name"
                required
              />
            </div>

            <div class="form-group">
              <label for="company">Company / Brand</label>
              <input
                id="company"
                name="Company"
                type="text"
                placeholder="Company name"
                required
              />
            </div>

          </div>

          <div class="form-row">

            <div class="form-group">
              <label for="email">Email Address</label>
              <input
                id="email"
                name="Email"
                type="email"
                placeholder="you@company.com"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone">Phone Number</label>
              <input
                id="phone"
                name="Phone"
                type="tel"
                placeholder="+91 XXXXX XXXXX"
              />
            </div>

          </div>

          <div class="form-group">
            <label for="collaboration">Collaboration Type</label>

            <select id="budget" name="budget">
              <option value="">Select collaboration type</option>
              <option value="Sponsored Job Listing">
                Sponsored Job Listing
              </option>
              <option value="Brand Advertising">
                Brand Advertising
              </option>
              <option value="College / Coaching Collaboration">
                College / Coaching Collaboration
              </option>
              <option value="Event Promotion">
                Event Promotion
              </option>
              <option value="Career Partnership">
                Career Partnership
              </option>
              <option value="Custom Partnership">
                Custom Partnership
              </option>
            </select>
          </div>

          <div class="form-group">
            <label for="budget">Estimated Budget</label>

            <select id="budget" name="Estimated Budget">
              <option value="">Select budget range</option>
              <option value="Under ₹5,000">Under ₹5,000</option>
              <option value="₹5,000 - ₹10,000">₹5,000 - ₹10,000</option>
              <option value="₹10,000 - ₹25,000">₹10,000 - ₹25,000</option>
              <option value="₹25,000 - ₹50,000">₹25,000 - ₹50,000</option>
              <option value="₹50,000+">₹50,000+</option>
              <option value="Let's Discuss">Let's Discuss</option>
            </select>
          </div>

          <div class="form-group">
            <label for="message">Tell Us About Your Requirement</label>

            <textarea
              id="message"
              name="Message"
              rows="5"
              placeholder="Tell us about your company, campaign or collaboration idea..."
              required
            ></textarea>
          </div>

          <button type="submit" class="submit-button" id="submit-button">
            Send Collaboration Request
            <span>→</span>
          </button>

          <p class="form-note" id="form-message">
            We'll review your request and get back to you as soon as possible.
          </p>

        </form>
      </div>

    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="final-cta-inner">
      <h2>Let's build something valuable together.</h2>
      <p>
        Whether you're hiring, advertising or looking for a long-term
        partnership, we'd love to hear from you.
      </p>

      <a href="#contact">
        Get in Touch →
      </a>
    </div>
  </section>

</Layout>

