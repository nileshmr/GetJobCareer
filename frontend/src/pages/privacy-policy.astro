---
import Layout from "../layouts/Layout.astro";

const pageTitle = "Privacy Policy | GetJobCareer";
const pageDescription =
  "Read the Privacy Policy of GetJobCareer to understand how we collect, use, protect, and handle information when you use our job portal and career resources.";
const canonicalUrl = "https://getjobcareer.com/privacy-policy";

const privacySchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: pageTitle,
  description: pageDescription,
  url: canonicalUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "GetJobCareer",
    url: "https://getjobcareer.com/",
  },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <!-- SEO Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(privacySchema)}
    />

    <!-- Hero -->
    <section class="hero-section" aria-labelledby="privacy-title">
      <div class="container hero-content">
        <span class="eyebrow">Legal & Privacy</span>

        <h1 id="privacy-title">Privacy Policy</h1>

        <p class="hero-description">
          Your privacy matters to us. Learn how GetJobCareer collects, uses,
          and protects information when you use our website and services.
        </p>

        <p class="last-updated">
          Last updated: August 2026
        </p>
      </div>
    </section>

    <!-- Privacy Policy Content -->
    <section class="policy-section" aria-labelledby="privacy-content-title">
      <div class="container policy-layout">
        <!-- Main Content -->
        <article class="policy-content">
          <h2 id="privacy-content-title">Privacy Policy for GetJobCareer</h2>

          <p>
            Welcome to GetJobCareer. We respect your privacy and are committed
            to protecting the information you share with us. This Privacy
            Policy explains what information we may collect, how we use it,
            how we protect it, and the choices available to you when using
            GetJobCareer.
          </p>

          <p>
            By accessing or using
            <strong>getjobcareer.com</strong>, you agree to the practices
            described in this Privacy Policy.
          </p>

          <h2>1. Information We Collect</h2>

          <p>
            We may collect information that you voluntarily provide when you
            interact with our website. The type of information collected
            depends on the features you use.
          </p>

          <h3>Information You Provide</h3>

          <ul>
            <li>Your name</li>
            <li>Email address</li>
            <li>Phone number</li>
            <li>Job and career preferences</li>
            <li>Information submitted through forms</li>
            <li>Messages or inquiries sent through our Contact Us page</li>
          </ul>

          <p>
            You are not required to provide personal information simply to
            browse publicly available pages on our website. Some features,
            however, may require certain information to function properly.
          </p>

          <h3>Automatically Collected Information</h3>

          <p>
            When you visit our website, certain technical information may be
            collected automatically. This may include your IP address,
            browser type, device information, operating system, referring
            pages, pages visited, and general usage information.
          </p>

          <p>
            This information may be used to understand website usage, improve
            performance, maintain security, and provide a better user
            experience.
          </p>

          <h2>2. How We Use Your Information</h2>

          <p>
            Information collected through GetJobCareer may be used for the
            following purposes:
          </p>

          <ul>
            <li>To provide and maintain our website and services</li>
            <li>To display relevant job opportunities and career resources</li>
            <li>To respond to questions, requests, or support inquiries</li>
            <li>To provide job alerts when you choose to subscribe</li>
            <li>To improve website content, functionality, and performance</li>
            <li>To detect and prevent fraudulent or abusive activity</li>
            <li>To maintain website security</li>
            <li>To comply with applicable legal requirements</li>
          </ul>

          <h2>3. Job Listings and Third-Party Websites</h2>

          <p>
            GetJobCareer may provide information about jobs, companies,
            internships, recruitment opportunities, and other career-related
            resources.
          </p>

          <p>
            Some job listings may contain links to external websites,
            application pages, employer websites, or third-party services.
            When you click an external link, you may leave GetJobCareer and
            become subject to the privacy policy and terms of that third
            party.
          </p>

          <p>
            We encourage you to review the privacy policies of external
            websites before providing them with personal information.
          </p>

          <h2>4. Cookies and Similar Technologies</h2>

          <p>
            GetJobCareer may use cookies and similar technologies to improve
            website functionality, remember preferences, understand website
            traffic, and provide a better browsing experience.
          </p>

          <p>
            Cookies may also be used by third-party services, including
            analytics or advertising providers, depending on the features
            enabled on the website.
          </p>

          <p>
            You can control or disable cookies through your browser settings.
            Disabling certain cookies may affect the functionality of some
            parts of the website.
          </p>

          <h2>5. Advertising and Google AdSense</h2>

          <p>
            GetJobCareer may display advertisements from third-party
            advertising networks, including Google AdSense.
          </p>

          <p>
            Third-party advertising providers may use cookies or similar
            technologies to display advertisements based on a user's visits to
            this and other websites.
          </p>

          <p>
            Google may use advertising cookies to help serve advertisements.
            Users may be able to manage certain advertising preferences
            through Google's available advertising settings.
          </p>

          <p>
            We do not control the information practices of third-party
            advertisers. Their use of information is governed by their own
            privacy policies and terms.
          </p>

          <h2>6. Analytics</h2>

          <p>
            We may use analytics services to understand how visitors interact
            with GetJobCareer. Analytics information can help us understand
            traffic patterns, popular pages, technical issues, and overall
            website performance.
          </p>

          <p>
            Analytics providers may collect information according to their
            respective privacy policies.
          </p>

          <h2>7. How We Protect Your Information</h2>

          <p>
            We take reasonable technical and organizational measures to
            protect information from unauthorized access, alteration,
            disclosure, or destruction.
          </p>

          <p>
            However, no method of transmitting information over the Internet
            or storing information electronically can be guaranteed to be
            completely secure. Therefore, we cannot guarantee absolute
            security.
          </p>

          <h2>8. Data Retention</h2>

          <p>
            We retain information only for as long as reasonably necessary for
            the purposes described in this Privacy Policy, including providing
            services, maintaining records, resolving disputes, preventing
            abuse, and complying with legal obligations.
          </p>

          <p>
            Retention periods may vary depending on the type of information
            and the reason it was collected.
          </p>

          <h2>9. Sharing of Information</h2>

          <p>
            We do not sell your personal information simply because you use
            GetJobCareer.
          </p>

          <p>
            Information may be shared with service providers or third parties
            when reasonably necessary to operate the website, provide
            requested services, maintain security, process communications, or
            comply with legal obligations.
          </p>

          <p>
            We may also disclose information where required by law or where
            necessary to protect the rights, safety, and security of
            GetJobCareer, our users, or others.
          </p>

          <h2>10. Your Choices</h2>

          <p>
            Depending on the information and service involved, you may have
            choices regarding how your information is used.
          </p>

          <ul>
            <li>
              You can choose not to provide optional personal information.
            </li>
            <li>
              You can unsubscribe from optional communications where an
              unsubscribe option is provided.
            </li>
            <li>
              You can manage cookies through your browser settings.
            </li>
            <li>
              You can contact us regarding questions about your personal
              information.
            </li>
          </ul>

          <h2>11. Children's Privacy</h2>

          <p>
            GetJobCareer is intended for general audiences and career seekers.
            We do not knowingly collect personal information from children
            where such collection is prohibited by applicable law.
          </p>

          <p>
            If you believe that a child has provided personal information to
            us without appropriate consent, please contact us so that we can
            take appropriate action.
          </p>

          <h2>12. Third-Party Links</h2>

          <p>
            Our website may contain links to third-party websites, including
            company websites, job application pages, social media platforms,
            educational resources, and other external services.
          </p>

          <p>
            We are not responsible for the privacy practices, content, or
            security of third-party websites. We recommend reviewing their
            privacy policies before interacting with them.
          </p>

          <h2>13. Changes to This Privacy Policy</h2>

          <p>
            We may update this Privacy Policy from time to time to reflect
            changes to our website, services, legal requirements, or privacy
            practices.
          </p>

          <p>
            When changes are made, the updated version will be published on
            this page with a revised "Last updated" date.
          </p>

          <h2>14. Contact Us</h2>

          <p>
            If you have questions, concerns, or requests regarding this
            Privacy Policy or how GetJobCareer handles information, you can
            contact us through our Contact Us page.
          </p>

          <div class="contact-box">
            <h3>Have a Privacy Question?</h3>

            <p>
              If you have a question about privacy or your information,
              we're happy to hear from you.
            </p>

            <a href="/contact" class="contact-button">
              Contact Us
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <!-- Sidebar -->
        <aside class="policy-sidebar" aria-label="Privacy Policy navigation">
          <div class="sidebar-card">
            <h2>Privacy Policy</h2>

            <nav>
              <a href="#privacy-content-title">Overview</a>
              <a href="#information">Information We Collect</a>
              <a href="#usage">How We Use Information</a>
              <a href="#cookies">Cookies</a>
              <a href="#advertising">Advertising</a>
              <a href="#security">Security</a>
              <a href="#choices">Your Choices</a>
              <a href="#changes">Policy Changes</a>
              <a href="#contact">Contact Us</a>
            </nav>
          </div>
        </aside>
      </div>
    </section>

    <!-- Related Links -->
    <section class="related-section" aria-labelledby="related-heading">
      <div class="container">
        <div class="related-card">
          <span class="section-label">GetJobCareer</span>

          <h2 id="related-heading">
            Explore GetJobCareer
          </h2>

          <p>
            Find job opportunities, explore companies, and access useful
            career resources for your professional journey.
          </p>

          <div class="related-actions">
            <a href="/jobs" class="primary-button">
              Browse Jobs
              <span aria-hidden="true">→</span>
            </a>

            <a href="/resources" class="secondary-button">
              Career Resources
            </a>

            <a href="/contact" class="secondary-button">
              Contact Us
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script lang="ts">
  const sidebarLinks =
    document.querySelectorAll<HTMLAnchorElement>(
      ".policy-sidebar a"
    );

  sidebarLinks.forEach((link) => {
    link.addEventListener("click", () => {
      sidebarLinks.forEach((item) => {
        item.classList.remove("active");
      });

      link.classList.add("active");
    });
  });
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #0f172a;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin-inline: auto;
  }

  /* =========================
     HERO
  ========================= */

  .hero-section {
    background:
      linear-gradient(
        180deg,
        #ecfdf5 0%,
        #f8fafc 100%
      );

    border-bottom: 1px solid #e2e8f0;
  }

  .hero-content {
    padding: 70px 0 62px;
    text-align: center;
  }

  .eyebrow,
  .section-label {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-content h1 {
    margin: 12px auto 0;
    color: #0f172a;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .hero-description {
    max-width: 700px;
    margin: 18px auto 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.7;
  }

  .last-updated {
    margin: 18px 0 0;
    color: #94a3b8;
    font-size: 13px;
    font-weight: 600;
  }

  /* =========================
     POLICY
  ========================= */

  .policy-section {
    padding: 55px 0 80px;
  }

  .policy-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 55px;
    align-items: start;
  }

  .policy-content {
    max-width: 850px;
  }

  .policy-content h2 {
    margin: 38px 0 14px;
    color: #0f172a;
    font-size: 27px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .policy-content h2:first-child {
    margin-top: 0;
  }

  .policy-content h3 {
    margin: 28px 0 9px;
    color: #1e293b;
    font-size: 20px;
    line-height: 1.4;
  }

  .policy-content p {
    margin: 0 0 16px;
    color: #475569;
    font-size: 15px;
    line-height: 1.85;
  }

  .policy-content strong {
    color: #334155;
  }

  .policy-content ul {
    margin: 10px 0 22px;
    padding-left: 23px;
  }

  .policy-content li {
    margin: 9px 0;
    padding-left: 4px;
    color: #475569;
    font-size: 15px;
    line-height: 1.7;
  }

  /* =========================
     SIDEBAR
  ========================= */

  .policy-sidebar {
    position: sticky;
    top: 90px;
  }

  .sidebar-card {
    padding: 22px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    box-shadow:
      0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .sidebar-card h2 {
    margin: 0 0 15px;
    color: #0f172a;
    font-size: 18px;
  }

  .sidebar-card nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .sidebar-card a {
    display: block;
    padding: 9px 10px;
    border-radius: 8px;
    color: #64748b;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .sidebar-card a:hover,
  .sidebar-card a.active {
    background: #f0fdfa;
    color: #0f766e;
  }

  /* =========================
     CONTACT BOX
  ========================= */

  .contact-box {
    margin-top: 40px;
    padding: 28px;
    background: #f0fdfa;
    border: 1px solid #ccfbf1;
    border-radius: 15px;
  }

  .contact-box h3 {
    margin: 0 0 8px;
    color: #115e59;
    font-size: 20px;
  }

  .contact-box p {
    margin-bottom: 18px;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 11px 18px;
    border-radius: 9px;
    background: #0f766e;
    color: #ffffff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .contact-button:hover {
    background: #115e59;
    transform: translateY(-1px);
  }

  /* =========================
     RELATED
  ========================= */

  .related-section {
    padding: 0 0 80px;
  }

  .related-card {
    padding: 45px 35px;
    text-align: center;
    border-radius: 20px;
    background:
      linear-gradient(
        135deg,
        #0f766e 0%,
        #047857 100%
      );
  }

  .related-card .section-label {
    color: #ccfbf1;
  }

  .related-card h2 {
    margin: 10px 0 10px;
    color: #ffffff;
    font-size: 29px;
    line-height: 1.25;
  }

  .related-card p {
    max-width: 650px;
    margin: 0 auto 24px;
    color: #d1fae5;
    font-size: 15px;
    line-height: 1.7;
  }

  .related-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 19px;
    border-radius: 9px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  .primary-button {
    background: #ffffff;
    color: #065f46;
  }

  .primary-button:hover {
    background: #f0fdf4;
    transform: translateY(-1px);
  }

  .secondary-button {
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .secondary-button:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-1px);
  }

  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {
    .policy-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .policy-content {
      max-width: none;
    }

    .policy-sidebar {
      position: static;
      order: -1;
    }

    .sidebar-card nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4px;
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 24px, 1180px);
    }

    .hero-content {
      padding: 52px 0 48px;
    }

    .hero-content h1 {
      font-size: 35px;
    }

    .hero-description {
      font-size: 15px;
    }

    .policy-section {
      padding: 40px 0 55px;
    }

    .policy-content h2 {
      font-size: 24px;
      margin-top: 32px;
    }

    .policy-content h3 {
      font-size: 19px;
    }

    .policy-content p,
    .policy-content li {
      font-size: 14px;
    }

    .sidebar-card nav {
      grid-template-columns: 1fr;
    }

    .contact-box {
      padding: 23px;
    }

    .related-section {
      padding-bottom: 55px;
    }

    .related-card {
      padding: 36px 21px;
      border-radius: 16px;
    }

    .related-card h2 {
      font-size: 25px;
    }

    .related-actions {
      flex-direction: column;
    }

    .primary-button,
    .secondary-button {
      width: 100%;
    }
  }
</style>