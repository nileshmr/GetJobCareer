---
import Layout from "../layouts/Layout.astro";

const leaders = [
  {
    name: "Nilesh Maurya",
    role: "Founder",
    image: "/images/nilesh-maurya.jpg",
    bio: "Nilesh Maurya is the Founder of GetJobCareer, focused on making job opportunities easier to discover and helping students and job seekers find relevant career opportunities.",
  },
  {
    name: "Sandeep Kumar",
    role: "Co-Founder",
    image: "/images/sandeep-kumar.jpg",
    bio: "Sandeep Kumar is the Co-Founder of GetJobCareer, contributing to the platform's growth and helping build a reliable career and job discovery platform.",
  },
];
---

<Layout
  title="Founder & Co-Founder | GetJobCareer"
  description="Meet the Founder and Co-Founder of GetJobCareer."
>
  <main class="leadership-page">

    <!-- HERO -->
    <section class="hero">
      <div class="hero-content">
        <span class="eyebrow">GETJOBCAREER</span>

        <h1>
          Meet Our
          <span>Leadership</span>
        </h1>

        <p>
          Get to know the people behind GetJobCareer and our vision to make
          finding the right career opportunities simpler and more accessible.
        </p>
      </div>
    </section>


    <!-- FOUNDERS -->
    <section class="leaders-section">

      <div class="section-heading">
        <span class="section-label">OUR TEAM</span>

        <h2>Founder & Co-Founder</h2>

        <p>
          Meet the people behind GetJobCareer who are working to build a
          better career discovery platform for students, freshers and
          professionals.
        </p>
      </div>


      <div class="leaders-grid">

        {
          leaders.map((leader) => (
            <article class="leader-card">

              <div class="image-wrapper">
                <img
                  src={leader.image}
                  alt={`${leader.name} - ${leader.role} at GetJobCareer`}
                  loading="lazy"
                />
              </div>

              <div class="leader-content">

                <span class="role">
                  {leader.role}
                </span>

                <h3>
                  {leader.name}
                </h3>

                <p>
                  {leader.bio}
                </p>

                <div class="divider"></div>

                <span class="company">
                  GetJobCareer
                </span>

              </div>

            </article>
          ))
        }

      </div>
    </section>


    <!-- VISION -->
    <section class="vision-section">

      <div class="vision-content">

        <span class="section-label">
          OUR VISION
        </span>

        <h2>
          Connecting Talent With
          <span>Opportunity</span>
        </h2>

        <p>
          GetJobCareer aims to make job discovery easier by bringing relevant
          opportunities together in one simple platform for students,
          freshers, and experienced professionals.
        </p>

      </div>

    </section>

  </main>
</Layout>


<style>
  .leadership-page {
    min-height: 100vh;
    background: #ffffff;
    color: #111827;
  }

  /* HERO */

  .hero {
    padding: 90px 20px 75px;
    text-align: center;

    background:
      radial-gradient(
        circle at 50% 0%,
        rgba(20, 184, 166, 0.12),
        transparent 45%
      ),
      #f8fafc;

    border-bottom: 1px solid #e5e7eb;
  }

  .hero-content {
    max-width: 800px;
    margin: auto;
  }

  .eyebrow,
  .section-label {
    display: inline-block;

    font-size: 0.75rem;
    font-weight: 800;

    letter-spacing: 0.15em;

    color: #0f9f8f;
  }

  .hero h1 {
    margin: 18px 0;

    font-size: clamp(2.6rem, 6vw, 4.5rem);

    line-height: 1.05;

    letter-spacing: -0.04em;

    font-weight: 800;
  }

  .hero h1 span {
    display: block;

    background: linear-gradient(
      135deg,
      #0f9f8f,
      #087f73
    );

    -webkit-background-clip: text;
    background-clip: text;

    color: transparent;
  }

  .hero p {
    max-width: 650px;

    margin: auto;

    color: #64748b;

    font-size: 1.05rem;

    line-height: 1.8;
  }


  /* FOUNDERS SECTION */

  .leaders-section {
    max-width: 1150px;

    margin: auto;

    padding: 90px 20px;
  }

  .section-heading {
    max-width: 700px;

    margin: 0 auto 55px;

    text-align: center;
  }

  .section-heading h2 {
    margin: 12px 0;

    font-size: clamp(2rem, 4vw, 3rem);

    letter-spacing: -0.03em;
  }

  .section-heading p {
    color: #64748b;

    line-height: 1.7;
  }


  /* CARDS */

  .leaders-grid {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 35px;

    max-width: 900px;

    margin: auto;
  }

  .leader-card {
    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 24px;

    box-shadow:
      0 15px 45px rgba(15, 23, 42, 0.08);

    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .leader-card:hover {
    transform: translateY(-8px);

    box-shadow:
      0 25px 60px rgba(15, 23, 42, 0.14);
  }


  /* IMAGE */

  .image-wrapper {
    width: 100%;

    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: #f1f5f9;
  }

  .image-wrapper img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    transition:
      transform 0.5s ease;
  }

  .leader-card:hover
  .image-wrapper img {
    transform: scale(1.04);
  }


  /* CONTENT */

  .leader-content {
    padding: 30px;
  }

  .role {
    display: inline-flex;

    padding: 7px 13px;

    border-radius: 999px;

    background: #e6f7f4;

    color: #0f8f82;

    font-size: 0.72rem;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: 0.08em;
  }

  .leader-content h3 {
    margin: 16px 0 12px;

    font-size: 1.75rem;

    letter-spacing: -0.02em;
  }

  .leader-content p {
    margin: 0;

    color: #64748b;

    line-height: 1.75;

    font-size: 0.96rem;
  }

  .divider {
    height: 1px;

    margin: 25px 0 18px;

    background: #e5e7eb;
  }

  .company {
    font-size: 0.85rem;

    font-weight: 700;

    color: #475569;
  }


  /* VISION */

  .vision-section {
    padding: 90px 20px;

    background: #0f172a;

    color: white;

    text-align: center;
  }

  .vision-content {
    max-width: 750px;

    margin: auto;
  }

  .vision-section .section-label {
    color: #5eead4;
  }

  .vision-section h2 {
    margin: 15px 0 20px;

    font-size: clamp(2rem, 4vw, 3.2rem);

    line-height: 1.15;

    letter-spacing: -0.03em;
  }

  .vision-section h2 span {
    color: #5eead4;
  }

  .vision-section p {
    margin: 0;

    color: #cbd5e1;

    line-height: 1.8;

    font-size: 1rem;
  }


  /* MOBILE */

  @media (max-width: 700px) {

    .hero {
      padding: 65px 18px 55px;
    }

    .leaders-section {
      padding: 65px 18px;
    }

    .leaders-grid {
      grid-template-columns: 1fr;

      max-width: 480px;
    }

    .leader-content {
      padding: 24px;
    }

    .vision-section {
      padding: 65px 18px;
    }
  }
</style>
