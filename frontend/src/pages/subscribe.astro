---

import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
---

<Layout
title="Subscribe for Job Alerts | JobPortal"
description="Subscribe to JobPortal job alerts and get notified about new internships and job opportunities."

>

  <main class="subscribe-page">
    <section class="subscribe-section">
      <div class="subscribe-glow glow-one"></div>
      <div class="subscribe-glow glow-two"></div>


  <div class="subscribe-container">

    <!-- Header -->
    <div class="subscribe-header">
      <span class="subscribe-badge">
        <span class="badge-dot"></span>
        Never miss a new opportunity
      </span>

      <h1>
        Get the latest
        <span>job alerts</span>
        directly
      </h1>

      <p>
        Subscribe to receive new job and internship opportunities based
        on your preferred categories. Choose email, WhatsApp, or both.
      </p>
    </div>

    <!-- Form Card -->
    <div class="subscribe-card">

      <form id="subscribe-form">

        <!-- Name -->
        <div class="form-group">
          <label for="name">
            Full Name
            <span>*</span>
          </label>

          <input
            id="name"
            name="name"
            type="text"
            placeholder="Enter your full name"
            required
          />
        </div>

        <!-- Email -->
        <div class="form-group">
          <label for="email">
            Email Address
            <span>*</span>
          </label>

          <input
            id="email"
            name="email"
            type="email"
            placeholder="you@example.com"
            required
          />
        </div>

        <!-- Phone -->
        <div class="form-group">
          <label for="phone">
            Phone Number
            <span>*</span>
          </label>

          <input
            id="phone"
            name="phone"
            type="tel"
            placeholder="Enter your phone number"
            required
          />
        </div>

        <!-- Notification Preferences -->
        <div class="form-section">
          <h2>Notification Preferences</h2>
          <p class="form-help">
            Select how you want to receive job alerts.
          </p>

          <div class="notification-options">

            <label class="notification-option">
              <input
                type="checkbox"
                name="emailOptIn"
                id="emailOptIn"
              />

              <div class="option-content">
                <strong>Email Alerts</strong>
                <span>Receive new jobs and internships by email.</span>
              </div>
            </label>

            <label class="notification-option">
              <input
                type="checkbox"
                name="whatsappOptIn"
                id="whatsappOptIn"
              />

              <div class="option-content">
                <strong>WhatsApp Alerts</strong>
                <span>Receive new job opportunities on WhatsApp.</span>
              </div>
            </label>

          </div>
        </div>

        <!-- Categories -->
        <div class="form-section">
          <h2>Job Categories</h2>

          <p class="form-help">
            Select the types of opportunities you are interested in.
          </p>

          <div class="category-grid">

            <label class="category-option">
              <input type="checkbox" name="categories" value="Frontend" />
              <span>Frontend</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="Backend" />
              <span>Backend</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="Fullstack" />
              <span>Fullstack</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="Data" />
              <span>Data</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="QA" />
              <span>QA / Testing</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="DevOps" />
              <span>DevOps</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="Internship" />
              <span>Internships</span>
            </label>

            <label class="category-option">
              <input type="checkbox" name="categories" value="Remote" />
              <span>Remote Jobs</span>
            </label>

          </div>
        </div>

        <!-- Message -->
        <div id="form-message" class="form-message" hidden></div>

        <!-- Submit -->
        <button type="submit" id="submit-button" class="subscribe-button">
          <span id="button-text">Subscribe for Job Alerts</span>
          <span id="button-loading" hidden>Subscribing...</span>
          <span class="arrow">→</span>
        </button>

        <p class="privacy-text">
          Your information will only be used for job alert notifications.
        </p>

      </form>
    </div>

  </div>
</section>
```

  </main>
</Layout>

<script>
  const form = document.querySelector("#subscribe-form") as HTMLFormElement;
  const message = document.querySelector("#form-message") as HTMLDivElement;
  const submitButton = document.querySelector(
    "#submit-button"
  ) as HTMLButtonElement;
  const buttonText = document.querySelector("#button-text") as HTMLSpanElement;
  const buttonLoading = document.querySelector(
    "#button-loading"
  ) as HTMLSpanElement;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    message.hidden = true;
    message.textContent = "";

    const name = (
      document.querySelector("#name") as HTMLInputElement
    ).value.trim();

    const email = (
      document.querySelector("#email") as HTMLInputElement
    ).value.trim();

    const phone = (
      document.querySelector("#phone") as HTMLInputElement
    ).value.trim();

    const emailOptIn = (
      document.querySelector("#emailOptIn") as HTMLInputElement
    ).checked;

    const whatsappOptIn = (
      document.querySelector("#whatsappOptIn") as HTMLInputElement
    ).checked;

    const categoryInputs = document.querySelectorAll(
      'input[name="categories"]:checked'
    ) as NodeListOf<HTMLInputElement>;

    const categories = Array.from(categoryInputs).map(
      (input) => input.value
    );

    if (!emailOptIn && !whatsappOptIn) {
      showMessage(
        "Please select at least one notification method.",
        "error"
      );
      return;
    }

    if (categories.length === 0) {
      showMessage(
        "Please select at least one job category.",
        "error"
      );
      return;
    }

    submitButton.disabled = true;
    buttonText.hidden = true;
    buttonLoading.hidden = false;

    try {
      const response = await fetch(`https://get-job-career.vercel.app/api/subscribers`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          name,
          email,
          phone,
          emailOptIn,
          whatsappOptIn,
          categories,
        }),
      });

      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(
          data.message || "Unable to subscribe. Please try again."
        );
      }

      showMessage(
        data.message ||
          "Successfully subscribed! You will receive job alerts based on your preferences.",
        "success"
      );

      form.reset();

    } catch (error) {
      showMessage(
        error instanceof Error
          ? error.message
          : "Something went wrong. Please try again.",
        "error"
      );
    } finally {
      submitButton.disabled = false;
      buttonText.hidden = false;
      buttonLoading.hidden = true;
    }
  });

  function showMessage(text: string, type: "success" | "error") {
    message.textContent = text;
    message.className = `form-message ${type}`;
    message.hidden = false;
  }
</script>

<style>
  .subscribe-page {
    min-height: calc(100vh - 80px);
  }

  .subscribe-section {
    position: relative;
    overflow: hidden;
    padding: 80px 20px;
    background:
      linear-gradient(
        180deg,
        #ecfdf8 0%,
        #f8fffd 38%,
        #ffffff 100%
      );
  }

  .subscribe-container {
    position: relative;
    z-index: 2;
    max-width: 700px;
    margin: auto;
  }

  .subscribe-glow {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }

  .glow-one {
    top: -180px;
    left: 10%;
    background: rgba(45, 212, 191, 0.18);
  }

  .glow-two {
    top: 100px;
    right: 5%;
    background: rgba(52, 211, 153, 0.1);
  }

  /* HEADER */

  .subscribe-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .subscribe-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 15px;
    border-radius: 999px;
    background: #dffaf3;
    color: #0f8f7c;
    font-size: 12px;
    font-weight: 600;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #14b8a6;
  }

  .subscribe-header h1 {
    margin: 22px auto 0;
    max-width: 650px;
    color: #0f172a;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.08;
    letter-spacing: -2px;
    font-weight: 800;
  }

  .subscribe-header h1 span {
    color: #0f9f8c;
  }

  .subscribe-header p {
    max-width: 570px;
    margin: 18px auto 0;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  /* CARD */

  .subscribe-card {
    position: relative;
    padding: 32px;
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow: 0 15px 45px rgba(15, 23, 42, 0.07);
  }

  /* FORM */

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 7px;
    color: #334155;
    font-size: 12px;
    font-weight: 700;
  }

  .form-group label span {
    color: #ef4444;
  }

  .form-group input[type="text"],
  .form-group input[type="email"],
  .form-group input[type="tel"] {
    width: 100%;
    box-sizing: border-box;
    padding: 13px 14px;
    border: 1px solid #dbe3eb;
    border-radius: 9px;
    outline: none;
    background: #ffffff;
    color: #0f172a;
    font-size: 13px;
    transition: 0.2s;
  }

  .form-group input:focus {
    border-color: #14b8a6;
    box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
  }

  .form-group input::placeholder {
    color: #94a3b8;
  }

  /* SECTIONS */

  .form-section {
    margin-top: 28px;
    padding-top: 25px;
    border-top: 1px solid #f1f5f9;
  }

  .form-section h2 {
    margin: 0;
    color: #0f172a;
    font-size: 15px;
    font-weight: 700;
  }

  .form-help {
    margin: 5px 0 15px;
    color: #94a3b8;
    font-size: 11px;
    line-height: 1.5;
  }

  /* NOTIFICATION OPTIONS */

  .notification-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .notification-option {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    padding: 14px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    cursor: pointer;
    transition: 0.2s;
  }

  .notification-option:hover {
    border-color: #5eead4;
    background: #f8fffd;
  }

  .notification-option input {
    margin-top: 2px;
    width: 16px;
    height: 16px;
    accent-color: #14b8a6;
  }

  .option-content strong,
  .option-content span {
    display: block;
  }

  .option-content strong {
    color: #334155;
    font-size: 12px;
  }

  .option-content span {
    margin-top: 4px;
    color: #94a3b8;
    font-size: 10px;
    line-height: 1.5;
  }

  /* CATEGORIES */

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 9px;
  }

  .category-option {
    cursor: pointer;
  }

  .category-option input {
    display: none;
  }

  .category-option span {
    display: block;
    padding: 9px 8px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-align: center;
    color: #64748b;
    background: white;
    font-size: 10px;
    transition: 0.2s;
  }

  .category-option:hover span {
    border-color: #5eead4;
    color: #0f9f8c;
  }

  .category-option input:checked + span {
    border-color: #14b8a6;
    background: #ecfdf8;
    color: #0f8f7c;
    font-weight: 700;
  }

  /* MESSAGE */

  .form-message {
    margin-top: 20px;
    padding: 12px 14px;
    border-radius: 9px;
    font-size: 12px;
    line-height: 1.5;
  }

  .form-message.success {
    background: #ecfdf5;
    border: 1px solid #a7f3d0;
    color: #047857;
  }

  .form-message.error {
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #b91c1c;
  }

  /* BUTTON */

  .subscribe-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    margin-top: 22px;
    padding: 14px 20px;
    border: none;
    border-radius: 9px;
    background: linear-gradient(135deg, #14b8a6, #059669);
    color: white;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
  }

  .subscribe-button:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 7px 20px rgba(5, 150, 105, 0.25);
  }

  .subscribe-button:disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  .subscribe-button .arrow {
    font-size: 17px;
  }

  .privacy-text {
    margin: 13px 0 0;
    color: #94a3b8;
    text-align: center;
    font-size: 9px;
  }

  /* RESPONSIVE */

  @media (max-width: 650px) {
    .subscribe-section {
      padding: 55px 15px;
    }

    .subscribe-header h1 {
      font-size: 2.4rem;
      letter-spacing: -1px;
    }

    .subscribe-header p {
      font-size: 13px;
    }

    .subscribe-card {
      padding: 22px 18px;
    }

    .notification-options {
      grid-template-columns: 1fr;
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 380px) {
    .category-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
