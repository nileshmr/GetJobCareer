---
import Layout from "../layouts/Layout.astro";

const pageTitle =
  "Terms of Service | GetJobCareer - Job Search & Career Platform";

const pageDescription =
  "Read the Terms of Service for GetJobCareer. Learn about the rules, responsibilities, job listings, applications, website usage, user content, and limitations when using our career platform.";

const canonicalUrl = "https://getjobcareer.com/terms-of-service";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: "Terms of Service",
  description: pageDescription,
  url: canonicalUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "GetJobCareer",
    url: "https://getjobcareer.com/",
  },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <!-- SEO Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteSchema)}
    />

    <!-- Hero Section -->
    <section class="hero-section" aria-labelledby="terms-page-title">
      <div class="container hero-content">
        <span class="eyebrow">Legal Information</span>

        <h1 id="terms-page-title">
          Terms of Service
        </h1>

        <p class="hero-description">
          Please read these Terms of Service carefully before using
          GetJobCareer. These terms explain the rules and conditions
          that apply when you access and use our job search and career
          resources platform.
        </p>

        <p class="last-updated">
          Last updated: August 2026
        </p>
      </div>
    </section>

    <!-- Main Content -->
    <section
      class="terms-section"
      aria-labelledby="terms-content-heading"
    >
      <div class="container terms-layout">

        <!-- Main Terms Content -->
        <article class="terms-content">

          <div class="intro-box">
            <p>
              Welcome to <strong>GetJobCareer</strong>. By accessing or
              using our website, you agree to comply with these Terms
              of Service. If you do not agree with any part of these
              terms, please do not use the website.
            </p>
          </div>

          <h2 id="terms-content-heading">
            1. Acceptance of Terms
          </h2>

          <p>
            These Terms of Service govern your access to and use of
            GetJobCareer, including our job listings, career resources,
            company information, application links, subscription
            features, and other services available through the
            website.
          </p>

          <p>
            By accessing GetJobCareer, you acknowledge that you have
            read, understood, and agreed to these Terms of Service and
            our applicable policies.
          </p>

          <h2>
            2. About GetJobCareer
          </h2>

          <p>
            GetJobCareer is a career and job discovery platform that
            provides information about employment opportunities,
            internships, companies, career resources, and job-search
            guidance.
          </p>

          <p>
            GetJobCareer may provide links to external websites,
            employer websites, application portals, and third-party
            services. These external websites may have their own
            terms, privacy policies, and requirements.
          </p>

          <h2>
            3. Job Listings and Employment Information
          </h2>

          <p>
            Job listings published on GetJobCareer are provided for
            informational and career-discovery purposes. Job
            information may include details such as job title,
            company name, location, employment type, eligibility,
            salary information, application instructions, and
            external application links.
          </p>

          <p>
            While we aim to provide useful and accurate information,
            we do not guarantee that every job listing, company
            detail, salary figure, eligibility requirement, deadline,
            or application link is completely accurate, current, or
            available at all times.
          </p>

          <p>
            You should independently verify important job information
            with the relevant employer before applying or making
            employment-related decisions.
          </p>

          <h2>
            4. Applications and Hiring Decisions
          </h2>

          <p>
            GetJobCareer is not the employer for the jobs displayed on
            the platform unless explicitly stated otherwise.
          </p>

          <p>
            Applications may be submitted through external employer
            websites, recruitment platforms, or other third-party
            application systems.
          </p>

          <p>
            GetJobCareer does not control hiring decisions, interview
            processes, candidate selection, employment offers,
            salaries, working conditions, or recruitment outcomes.
          </p>

          <p>
            Any communication or transaction between a candidate and
            an employer is primarily between those parties.
          </p>

          <h2>
            5. User Responsibilities
          </h2>

          <p>
            When using GetJobCareer, you agree to use the website
            responsibly and lawfully.
          </p>

          <h3>
            You agree not to:
          </h3>

          <ul>
            <li>
              Use the website for unlawful or fraudulent purposes.
            </li>
            <li>
              Submit false, misleading, or fraudulent information.
            </li>
            <li>
              Attempt to interfere with the operation or security of
              the website.
            </li>
            <li>
              Access areas or information that you are not authorized
              to access.
            </li>
            <li>
              Copy, reproduce, scrape, or redistribute website
              content in a manner that violates applicable laws or
              rights.
            </li>
            <li>
              Use automated systems to abuse, overload, or disrupt
              website services.
            </li>
            <li>
              Attempt to introduce malicious software, harmful code,
              or other security threats.
            </li>
          </ul>

          <h2>
            6. Career Resources
          </h2>

          <p>
            GetJobCareer may provide career resources including
            resume guides, interview preparation materials, LinkedIn
            optimization advice, salary negotiation guidance, DSA
            resources, technical roadmaps, and job-search strategies.
          </p>

          <p>
            These resources are provided for general educational and
            informational purposes. They should not be considered
            professional, legal, financial, employment, or career
            advice tailored to your individual circumstances.
          </p>

          <h2>
            7. External Links and Third-Party Websites
          </h2>

          <p>
            Our website may contain links to third-party websites,
            including employer websites, job application portals,
            social media platforms, and other external services.
          </p>

          <p>
            We do not control or operate these third-party websites
            and are not responsible for their content, availability,
            security, privacy practices, terms, or services.
          </p>

          <p>
            You should review the terms and privacy policies of any
            third-party website before providing personal information
            or using its services.
          </p>

          <h2>
            8. Intellectual Property
          </h2>

          <p>
            Unless otherwise stated, the content and design of
            GetJobCareer, including text, graphics, logos, branding,
            page layouts, and original materials, may be protected by
            applicable intellectual property laws.
          </p>

          <p>
            You may access and use the website for personal,
            non-commercial purposes. You may not reproduce, modify,
            distribute, sell, or commercially exploit our original
            content without appropriate authorization.
          </p>

          <h2>
            9. User Submissions
          </h2>

          <p>
            If GetJobCareer provides features that allow users to
            submit information, feedback, messages, or other content,
            you are responsible for ensuring that the information you
            provide is accurate and lawful.
          </p>

          <p>
            You should not submit content that is illegal, misleading,
            abusive, defamatory, infringing, harmful, or violates the
            rights of another person or organization.
          </p>

          <h2>
            10. Email and Notification Services
          </h2>

          <p>
            If you subscribe to job alerts, career updates, or other
            notifications, you may receive communications related to
            the services you requested.
          </p>

          <p>
            You may be able to unsubscribe from promotional or
            notification communications using the available
            unsubscribe mechanism or by contacting us.
          </p>

          <h2>
            11. Privacy
          </h2>

          <p>
            Your use of GetJobCareer is also subject to our
            <a href="/privacy-policy">Privacy Policy</a>, which
            explains how information may be collected, used, and
            handled when you use our website.
          </p>

          <h2>
            12. Website Availability
          </h2>

          <p>
            We aim to keep GetJobCareer available and functioning
            properly, but we do not guarantee that the website will
            always be available, uninterrupted, secure, or free from
            errors.
          </p>

          <p>
            Services may occasionally be unavailable because of
            maintenance, technical problems, hosting issues, network
            failures, security incidents, or circumstances beyond our
            reasonable control.
          </p>

          <h2>
            13. Disclaimer of Warranties
          </h2>

          <p>
            GetJobCareer is provided on an "as available" and
            "as is" basis to the extent permitted by applicable law.
          </p>

          <p>
            We do not guarantee that the information available through
            the website will always be complete, accurate, reliable,
            current, or suitable for your particular purpose.
          </p>

          <p>
            We also do not guarantee employment, interviews, job
            offers, salary outcomes, or successful applications as a
            result of using the platform.
          </p>

          <h2>
            14. Limitation of Liability
          </h2>

          <p>
            To the maximum extent permitted by applicable law,
            GetJobCareer and its operators will not be responsible for
            indirect, incidental, consequential, or other losses
            arising from your use of the website or reliance on
            information provided through the platform.
          </p>

          <p>
            This includes, where applicable, losses associated with
            third-party websites, job listings, recruitment decisions,
            application processes, inaccurate information, technical
            interruptions, or unavailable services.
          </p>

          <h2>
            15. Changes to These Terms
          </h2>

          <p>
            We may update these Terms of Service from time to time to
            reflect changes to our services, website features,
            applicable requirements, or business practices.
          </p>

          <p>
            When changes are made, the updated version will be
            published on this page with a revised "Last updated"
            date.
          </p>

          <p>
            Your continued use of GetJobCareer after changes are
            published indicates your acceptance of the updated terms,
            subject to applicable law.
          </p>

          <h2>
            16. Termination or Restriction of Access
          </h2>

          <p>
            We may restrict or suspend access to the website where
            reasonably necessary to protect our services, users,
            systems, or legal rights, or where a user violates these
            Terms of Service.
          </p>

          <h2>
            17. Governing Law
          </h2>

          <p>
            These Terms of Service shall be interpreted and governed
            in accordance with applicable laws and regulations.
            Any disputes arising in connection with the use of
            GetJobCareer shall be handled in accordance with the
            applicable legal framework.
          </p>

          <h2>
            18. Contact Us
          </h2>

          <p>
            If you have questions about these Terms of Service,
            please contact us through our
            <a href="/contact">Contact Us</a> page.
          </p>

          <div class="final-note">
            <h2>
              Agreement to These Terms
            </h2>

            <p>
              By using GetJobCareer, you acknowledge that you have
              read and understood these Terms of Service and agree to
              comply with them while using our website and services.
            </p>
          </div>

        </article>

        <!-- Sidebar -->
        <aside class="terms-sidebar" aria-label="Terms navigation">
          <div class="sidebar-card">
            <h2>
              Terms Overview
            </h2>

            <nav>
              <a href="#terms-content-heading">
                Acceptance of Terms
              </a>

              <a href="#terms-content-heading">
                User Responsibilities
              </a>

              <a href="#terms-content-heading">
                Job Listings
              </a>

              <a href="#terms-content-heading">
                Privacy
              </a>

              <a href="#terms-content-heading">
                Intellectual Property
              </a>

              <a href="#terms-content-heading">
                Contact Us
              </a>
            </nav>
          </div>

          <div class="sidebar-card help-card">
            <span class="help-label">
              Need Help?
            </span>

            <h2>
              Have questions about our terms?
            </h2>

            <p>
              Contact our team if you need clarification about these
              Terms of Service.
            </p>

            <a href="/contact" class="sidebar-button">
              Contact Us
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </aside>

      </div>
    </section>

    <!-- Internal Navigation / SEO Section -->
    <section
      class="related-section"
      aria-labelledby="related-heading"
    >
      <div class="container related-content">

        <span class="section-label">
          GetJobCareer
        </span>

        <h2 id="related-heading">
          Explore GetJobCareer
        </h2>

        <p>
          GetJobCareer provides job opportunities, career resources,
          company information, and useful guidance for students,
          freshers, developers, and other job seekers.
        </p>

        <div class="related-links">
          <a href="/jobs">
            Browse Jobs
          </a>

          <a href="/companies">
            Explore Companies
          </a>

          <a href="/resources">
            Career Resources
          </a>

          <a href="/privacy-policy">
            Privacy Policy
          </a>

          <a href="/contact">
            Contact Us
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #0f172a;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin-inline: auto;
  }

  /* =========================
     HERO
  ========================= */

  .hero-section {
    background:
      linear-gradient(
        180deg,
        #ecfdf5 0%,
        #f8fafc 100%
      );
    border-bottom: 1px solid #e2e8f0;
  }

  .hero-content {
    padding: 68px 0 62px;
    text-align: center;
  }

  .eyebrow,
  .section-label,
  .help-label {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-content h1 {
    max-width: 850px;
    margin: 12px auto 0;
    color: #0f172a;
    font-size: clamp(36px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .hero-description {
    max-width: 760px;
    margin: 20px auto 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.7;
  }

  .last-updated {
    margin: 18px 0 0;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
  }

  /* =========================
     TERMS SECTION
  ========================= */

  .terms-section {
    padding: 60px 0 80px;
  }

  .terms-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: 50px;
    align-items: start;
  }

  .terms-content {
    min-width: 0;
  }

  .terms-content h2 {
    margin: 42px 0 14px;
    color: #0f172a;
    font-size: 26px;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .terms-content h2:first-of-type {
    margin-top: 32px;
  }

  .terms-content h3 {
    margin: 28px 0 10px;
    color: #1e293b;
    font-size: 19px;
    line-height: 1.4;
  }

  .terms-content p {
    margin: 0 0 16px;
    color: #475569;
    font-size: 15px;
    line-height: 1.85;
  }

  .terms-content a {
    color: #0f766e;
    font-weight: 600;
    text-decoration: none;
  }

  .terms-content a:hover {
    color: #115e59;
    text-decoration: underline;
  }

  .intro-box {
    padding: 22px 24px;
    margin-bottom: 8px;
    border-left: 4px solid #0f766e;
    border-radius: 10px;
    background: #f0fdfa;
  }

  .intro-box p {
    margin: 0;
    color: #334155;
  }

  .terms-content ul {
    margin: 12px 0 22px;
    padding-left: 22px;
    color: #475569;
  }

  .terms-content li {
    margin-bottom: 10px;
    padding-left: 5px;
    font-size: 15px;
    line-height: 1.7;
  }

  .final-note {
    margin-top: 48px;
    padding: 25px;
    border: 1px solid #ccfbf1;
    border-radius: 14px;
    background: #f0fdfa;
  }

  .final-note h2 {
    margin-top: 0;
    font-size: 22px;
  }

  .final-note p {
    margin-bottom: 0;
  }

  /* =========================
     SIDEBAR
  ========================= */

  .terms-sidebar {
    position: sticky;
    top: 24px;
  }

  .sidebar-card {
    margin-bottom: 18px;
    padding: 22px;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    background: #ffffff;
    box-shadow:
      0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .sidebar-card h2 {
    margin: 0 0 16px;
    color: #0f172a;
    font-size: 18px;
    line-height: 1.4;
  }

  .sidebar-card nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .sidebar-card nav a {
    padding: 9px 10px;
    border-radius: 8px;
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .sidebar-card nav a:hover {
    background: #f0fdfa;
    color: #0f766e;
  }

  .help-card {
    background:
      linear-gradient(
        145deg,
        #0f766e 0%,
        #047857 100%
      );
    border-color: transparent;
  }

  .help-card .help-label {
    color: #ccfbf1;
  }

  .help-card h2 {
    margin-top: 9px;
    color: #ffffff;
  }

  .help-card p {
    margin: 0 0 18px;
    color: #d1fae5;
    font-size: 13px;
    line-height: 1.7;
  }

  .sidebar-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    width: 100%;
    padding: 0 15px;
    border-radius: 8px;
    background: #ffffff;
    color: #065f46 !important;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .sidebar-button:hover {
    background: #f0fdf4;
    transform: translateY(-1px);
    text-decoration: none !important;
  }

  /* =========================
     RELATED / SEO
  ========================= */

  .related-section {
    padding: 0 0 80px;
  }

  .related-content {
    max-width: 900px;
  }

  .related-content h2 {
    margin: 9px 0 12px;
    color: #0f172a;
    font-size: 28px;
    line-height: 1.3;
  }

  .related-content > p {
    max-width: 800px;
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  .related-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .related-links a {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 16px;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    background: #ffffff;
    color: #0f766e;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .related-links a:hover {
    border-color: #99f6e4;
    background: #f0fdfa;
    transform: translateY(-1px);
  }

  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {
    .terms-layout {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .terms-sidebar {
      position: static;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .sidebar-card {
      margin-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 24px, 1180px);
    }

    .hero-content {
      padding: 52px 0 48px;
    }

    .hero-content h1 {
      font-size: 35px;
    }

    .hero-description {
      font-size: 15px;
    }

    .terms-section {
      padding: 42px 0 55px;
    }

    .terms-content h2 {
      margin-top: 34px;
      font-size: 23px;
    }

    .terms-content h3 {
      font-size: 18px;
    }

    .terms-content p,
    .terms-content li {
      font-size: 14px;
      line-height: 1.8;
    }

    .intro-box {
      padding: 18px;
    }

    .terms-sidebar {
      grid-template-columns: 1fr;
    }

    .related-section {
      padding-bottom: 55px;
    }

    .related-content h2 {
      font-size: 25px;
    }

    .related-links {
      flex-direction: column;
    }

    .related-links a {
      width: 100%;
      justify-content: center;
    }
  }
</style>