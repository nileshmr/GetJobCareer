---
import Layout from "../../layouts/Layout.astro";
import "../../styles/global.css";
---

<Layout
  title="Admin Dashboard - JobPortal"
  description="JobPortal administration dashboard"
>
  <div class="admin-page">

    <!-- Sidebar -->
    <aside class="sidebar">
      <div class="logo">
        Job<span>Portal</span>
      </div>

      <nav>
        <a href="/admin" class="active">
          <span>▦</span>
          Dashboard
        </a>

        <a href="/admin/jobs">
          <span>💼</span>
          Jobs
        </a>

        <a href="/admin/subscribers">
          <span>👥</span>
          Subscribers
        </a>

        <a href="/">
          <span>🌐</span>
          View Website
        </a>

        <!-- Logout -->
        <button type="button" id="logoutButton" class="logout-button">
          <span>↪</span>
          Logout
        </button>
      </nav>
    </aside>


    <!-- Main Content -->
    <main class="main-content">

      <!-- Topbar -->
      <header class="topbar">
        <div>
          <h1>Admin Dashboard</h1>
          <p>Manage your JobPortal platform</p>
        </div>

        <div class="admin-profile">
          <div class="avatar" id="adminAvatar">A</div>

          <div>
            <strong id="adminName">Admin</strong>
            <small>Administrator</small>
          </div>
        </div>
      </header>


      <!-- Loading -->
      <div id="loading" class="loading">
        Loading dashboard...
      </div>


      <!-- Error -->
      <div id="errorMessage" class="error-message hidden">
      </div>


      <!-- Dashboard Content -->
      <div id="dashboardContent" class="hidden">

        <!-- Statistics -->
        <section class="stats-grid">

          <div class="stat-card">
            <div class="stat-icon">👥</div>

            <div>
              <p>Total Subscribers</p>
              <h2 id="totalSubscribers">0</h2>
            </div>
          </div>


          <div class="stat-card">
            <div class="stat-icon">✓</div>

            <div>
              <p>Active Subscribers</p>
              <h2 id="activeSubscribers">0</h2>
            </div>
          </div>


          <div class="stat-card">
            <div class="stat-icon">✉</div>

            <div>
              <p>Email Opt-in</p>
              <h2 id="emailSubscribers">0</h2>
            </div>
          </div>


          <div class="stat-card">
            <div class="stat-icon">💬</div>

            <div>
              <p>WhatsApp Opt-in</p>
              <h2 id="whatsappSubscribers">0</h2>
            </div>
          </div>

        </section>


        <!-- Category Summary -->
        <section class="section">

          <div class="section-header">
            <div>
              <h2>Category-wise Subscribers</h2>
              <p>
                See how subscribers are distributed across job categories.
              </p>
            </div>
          </div>


          <div class="category-grid">

            <!-- IT Jobs -->
            <div class="category-card">
              <div class="category-top">
                <span class="category-icon">💻</span>
                <span class="count" id="itJobsCount">0</span>
              </div>

              <h3>IT Jobs</h3>
              <p>Software & Technology</p>

              <div class="category-details">
                <span id="itActive">Active: 0</span>
                <span id="itEmail">Email: 0</span>
                <span id="itWhatsapp">WhatsApp: 0</span>
              </div>
            </div>


            <!-- Internships -->
            <div class="category-card">
              <div class="category-top">
                <span class="category-icon">🎓</span>
                <span class="count" id="internshipsCount">0</span>
              </div>

              <h3>Internships</h3>
              <p>Start your career</p>

              <div class="category-details">
                <span id="internshipsActive">Active: 0</span>
                <span id="internshipsEmail">Email: 0</span>
                <span id="internshipsWhatsapp">WhatsApp: 0</span>
              </div>
            </div>


            <!-- Government Jobs -->
            <div class="category-card">
              <div class="category-top">
                <span class="category-icon">🏛️</span>
                <span class="count" id="governmentJobsCount">0</span>
              </div>

              <h3>Government Jobs</h3>
              <p>Public sector opportunities</p>

              <div class="category-details">
                <span id="governmentActive">Active: 0</span>
                <span id="governmentEmail">Email: 0</span>
                <span id="governmentWhatsapp">WhatsApp: 0</span>
              </div>
            </div>


            <!-- Private Jobs -->
            <div class="category-card">
              <div class="category-top">
                <span class="category-icon">🏢</span>
                <span class="count" id="privateJobsCount">0</span>
              </div>

              <h3>Private Jobs</h3>
              <p>Private sector careers</p>

              <div class="category-details">
                <span id="privateActive">Active: 0</span>
                <span id="privateEmail">Email: 0</span>
                <span id="privateWhatsapp">WhatsApp: 0</span>
              </div>
            </div>

          </div>

        </section>


        <!-- Subscribers -->
        <section class="section">

          <div class="section-header">
            <div>
              <h2>Subscribers</h2>
              <p>
                Complete subscriber information.
              </p>
            </div>

            <a href="/admin/subscribers" class="view-all">
              View All →
            </a>
          </div>


          <div class="table-container">

            <table>

              <thead>
                <tr>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Phone</th>
                  <th>Categories</th>
                  <th>Email</th>
                  <th>WhatsApp</th>
                  <th>Status</th>
                  <th>Joined</th>
                </tr>
              </thead>


              <tbody id="subscribersTableBody">
              </tbody>

            </table>

          </div>

        </section>

      </div>

    </main>

  </div>
</Layout>


<script>
  interface Subscriber {
    _id: string;
    name: string;
    email: string;
    phone: string;
    whatsappOptIn: boolean;
    emailOptIn: boolean;
    categories: string[];
    isActive: boolean;
    createdAt?: string;
  }


  interface CategoryStat {
    category: string;
    totalSubscribers: number;
    activeSubscribers: number;
    emailOptIn: number;
    whatsappOptIn: number;
  }


  interface StoredAdmin {
    id?: string;
    name?: string;
    email?: string;
    role?: string;
  }


  const API_URL =
    import.meta.env.PUBLIC_API_URL || "http://localhost:5000";


  const loading =
    document.getElementById("loading");

  const errorMessage =
    document.getElementById("errorMessage");

  const dashboardContent =
    document.getElementById("dashboardContent");

  const logoutButton =
    document.getElementById("logoutButton");


  /*
   * Get login token
   */
  function getToken(): string | null {
    return (
      localStorage.getItem("token") ||
      localStorage.getItem("accessToken")
    );
  }


  /*
   * Get request headers
   */
  function getHeaders() {
    const token = getToken();

    return {
      "Content-Type": "application/json",

      ...(token
        ? {
            Authorization: `Bearer ${token}`,
          }
        : {}),
    };
  }


  /*
   * Show error
   */
  function showError(message: string) {
    if (!errorMessage) return;

    errorMessage.textContent = message;
    errorMessage.classList.remove("hidden");
  }


  /*
   * Format date
   */
  function formatDate(date?: string) {
    if (!date) return "-";

    return new Date(date).toLocaleDateString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }


  /*
   * Status badge
   */
  function createStatusBadge(
    value: boolean,
    trueText: string,
    falseText: string
  ) {
    return `
      <span class="badge-status ${value ? "success" : "muted"}">
        ${value ? trueText : falseText}
      </span>
    `;
  }


  /*
   * Render subscribers
   */
  function renderSubscribers(
    subscribers: Subscriber[]
  ) {
    const tableBody =
      document.getElementById("subscribersTableBody");

    if (!tableBody) return;


    if (!subscribers.length) {
      tableBody.innerHTML = `
        <tr>
          <td colspan="8" class="empty">
            No subscribers found
          </td>
        </tr>
      `;

      return;
    }


    tableBody.innerHTML = subscribers
      .map((subscriber) => {

        const categories =
          subscriber.categories?.length
            ? subscriber.categories
                .map(
                  (category) =>
                    `<span class="category-badge">${category}</span>`
                )
                .join("")
            : `<span class="muted-text">No category</span>`;


        return `
          <tr>

            <td>
              <strong>${subscriber.name || "-"}</strong>
            </td>

            <td>
              ${subscriber.email || "-"}
            </td>

            <td>
              ${subscriber.phone || "-"}
            </td>

            <td>
              <div class="categories-list">
                ${categories}
              </div>
            </td>

            <td>
              ${createStatusBadge(
                subscriber.emailOptIn,
                "Yes",
                "No"
              )}
            </td>

            <td>
              ${createStatusBadge(
                subscriber.whatsappOptIn,
                "Yes",
                "No"
              )}
            </td>

            <td>
              ${createStatusBadge(
                subscriber.isActive,
                "Active",
                "Inactive"
              )}
            </td>

            <td>
              ${formatDate(subscriber.createdAt)}
            </td>

          </tr>
        `;
      })
      .join("");
  }


  /*
   * Set text content
   */
  function setText(
    id: string,
    value: string | number
  ) {
    const element =
      document.getElementById(id);

    if (element) {
      element.textContent = String(value);
    }
  }


  /*
   * Render category statistics
   */
  function renderCategoryStats(
    categories: CategoryStat[]
  ) {

    const categoryMap:
      Record<string, CategoryStat> = {};


    categories.forEach((category) => {
      categoryMap[category.category] =
        category;
    });


    const categoryConfig = [

      {
        name: "IT Jobs",
        count: "itJobsCount",
        active: "itActive",
        email: "itEmail",
        whatsapp: "itWhatsapp",
      },

      {
        name: "Internships",
        count: "internshipsCount",
        active: "internshipsActive",
        email: "internshipsEmail",
        whatsapp: "internshipsWhatsapp",
      },

      {
        name: "Government Jobs",
        count: "governmentJobsCount",
        active: "governmentActive",
        email: "governmentEmail",
        whatsapp: "governmentWhatsapp",
      },

      {
        name: "Private Jobs",
        count: "privateJobsCount",
        active: "privateActive",
        email: "privateEmail",
        whatsapp: "privateWhatsapp",
      },

    ];


    categoryConfig.forEach((config) => {

      const data =
        categoryMap[config.name];


      setText(
        config.count,
        data?.totalSubscribers || 0
      );


      setText(
        config.active,
        `Active: ${data?.activeSubscribers || 0}`
      );


      setText(
        config.email,
        `Email: ${data?.emailOptIn || 0}`
      );


      setText(
        config.whatsapp,
        `WhatsApp: ${data?.whatsappOptIn || 0}`
      );

    });
  }


  /*
   * Load admin information
   */
  function loadAdminProfile() {

    try {

      const storedAdmin =
        localStorage.getItem("admin");


      if (!storedAdmin) return;


      const admin: StoredAdmin =
        JSON.parse(storedAdmin);


      const adminName =
        document.getElementById("adminName");

      const adminAvatar =
        document.getElementById("adminAvatar");


      if (adminName && admin.name) {
        adminName.textContent =
          admin.name;
      }


      if (adminAvatar && admin.name) {
        adminAvatar.textContent =
          admin.name
            .charAt(0)
            .toUpperCase();
      }

    } catch (error) {

      console.error(
        "Failed to load admin profile:",
        error
      );

    }
  }


  /*
   * Logout
   */
  function logout() {

    localStorage.removeItem("token");
    localStorage.removeItem("accessToken");
    localStorage.removeItem("admin");

    window.location.href =
      "/admin/login";
  }


  /*
   * Attach logout event
   */
  logoutButton?.addEventListener(
    "click",
    logout
  );


  /*
   * Load dashboard
   */
  async function loadDashboard() {

    try {

      if (loading) {
        loading.classList.remove("hidden");
      }


      if (dashboardContent) {
        dashboardContent.classList.add("hidden");
      }


      if (errorMessage) {
        errorMessage.classList.add("hidden");
      }


      const headers =
        getHeaders();


      /*
       * Get all subscribers
       */
      const subscribersResponse =
        await fetch(
          `${API_URL}/api/subscribers`,
          {
            method: "GET",
            headers,
          }
        );


      if (!subscribersResponse.ok) {

        if (
          subscribersResponse.status === 401 ||
          subscribersResponse.status === 403
        ) {

          localStorage.removeItem("token");
          localStorage.removeItem("accessToken");
          localStorage.removeItem("admin");

          window.location.href =
            "/admin/login";

          return;
        }


        throw new Error(
          "Failed to fetch subscribers."
        );
      }


      const subscribersData =
        await subscribersResponse.json();


      /*
       * Get category statistics
       */
      const categoryResponse =
        await fetch(
          `${API_URL}/api/subscribers/stats/categories`,
          {
            method: "GET",
            headers,
          }
        );


      if (!categoryResponse.ok) {

        if (
          categoryResponse.status === 401 ||
          categoryResponse.status === 403
        ) {

          localStorage.removeItem("token");
          localStorage.removeItem("accessToken");
          localStorage.removeItem("admin");

          window.location.href =
            "/admin/login";

          return;
        }


        throw new Error(
          "Failed to fetch category statistics."
        );
      }


      const categoryData =
        await categoryResponse.json();


      const subscribers:
        Subscriber[] =
          subscribersData.subscribers || [];


      /*
       * Overall statistics
       */
      const total =
        subscribers.length;


      const active =
        subscribers.filter(
          (subscriber) =>
            subscriber.isActive
        ).length;


      const email =
        subscribers.filter(
          (subscriber) =>
            subscriber.emailOptIn
        ).length;


      const whatsapp =
        subscribers.filter(
          (subscriber) =>
            subscriber.whatsappOptIn
        ).length;


      /*
       * Update statistics
       */
      setText(
        "totalSubscribers",
        total
      );


      setText(
        "activeSubscribers",
        active
      );


      setText(
        "emailSubscribers",
        email
      );


      setText(
        "whatsappSubscribers",
        whatsapp
      );


      /*
       * Category statistics
       */
      renderCategoryStats(
        categoryData.categories || []
      );


      /*
       * Subscriber table
       */
      renderSubscribers(
        subscribers
      );


      /*
       * Show dashboard
       */
      if (loading) {
        loading.classList.add("hidden");
      }


      if (dashboardContent) {
        dashboardContent.classList.remove("hidden");
      }

    } catch (error) {

      console.error(
        "Dashboard error:",
        error
      );


      if (loading) {
        loading.classList.add("hidden");
      }


      showError(
        error instanceof Error
          ? error.message
          : "Something went wrong while loading dashboard."
      );

    }
  }


  /*
   * IMPORTANT:
   * Check authentication before loading dashboard.
   */
  const token = getToken();


  if (!token) {

    window.location.href =
      "/admin/login";

  } else {

    loadAdminProfile();

    loadDashboard();

  }
</script>


<style>

  .admin-page {
    min-height: 100vh;
    background: #f8fafc;
    display: flex;
  }


  /* Sidebar */

  .sidebar {
    width: 240px;
    min-height: 100vh;
    background: #111827;
    color: white;
    padding: 28px 18px;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 10;
  }


  .logo {
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 45px;
    padding-left: 10px;
  }


  .logo span {
    color: #6366f1;
  }


  .sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }


  .sidebar nav a,
  .logout-button {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    width: 100%;
    box-sizing: border-box;
  }


  .sidebar nav a:hover,
  .sidebar nav a.active {
    background: #4f46e5;
    color: white;
  }


  /* Logout */

  .logout-button {
    border: none;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }


  .logout-button:hover {
    background: #dc2626;
    color: white;
  }


  /* Main */

  .main-content {
    margin-left: 240px;
    width: calc(100% - 240px);
    padding: 35px 45px;
  }


  /* Topbar */

  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
  }


  .topbar h1 {
    margin: 0;
    font-size: 30px;
  }


  .topbar p {
    margin: 7px 0 0;
    color: #64748b;
  }


  .admin-profile {
    display: flex;
    align-items: center;
    gap: 12px;
  }


  .admin-profile small {
    display: block;
    color: #64748b;
    margin-top: 3px;
  }


  .avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #4f46e5;
    color: white;
    display: grid;
    place-items: center;
    font-weight: 700;
  }


  /* Loading */

  .loading {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 30px;
    text-align: center;
    color: #64748b;
    margin-bottom: 30px;
  }


  .hidden {
    display: none !important;
  }


  .error-message {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
    border-radius: 10px;
    padding: 15px 18px;
    margin-bottom: 25px;
  }


  /* Stats */

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 35px;
  }


  .stat-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 22px;
    display: flex;
    align-items: center;
    gap: 16px;
  }


  .stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    background: #eef2ff;
    display: grid;
    place-items: center;
    font-size: 20px;
  }


  .stat-card p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
  }


  .stat-card h2 {
    margin: 5px 0 0;
    font-size: 26px;
  }


  /* Sections */

  .section {
    margin-bottom: 35px;
  }


  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
  }


  .section-header h2 {
    margin: 0;
    font-size: 21px;
  }


  .section-header p {
    margin: 6px 0 0;
    color: #64748b;
    font-size: 14px;
  }


  .view-all {
    text-decoration: none;
    color: #4f46e5;
    font-weight: 600;
    font-size: 14px;
  }


  /* Category */

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }


  .category-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 22px;
  }


  .category-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }


  .category-icon {
    font-size: 24px;
  }


  .count {
    font-size: 25px;
    font-weight: 700;
  }


  .category-card h3 {
    margin: 18px 0 5px;
  }


  .category-card > p {
    margin: 0;
    color: #64748b;
    font-size: 13px;
  }


  .category-details {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 18px;
  }


  .category-details span {
    background: #f1f5f9;
    padding: 5px 8px;
    border-radius: 5px;
    font-size: 11px;
    color: #475569;
  }


  /* Table */

  .table-container {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    overflow-x: auto;
  }


  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 1100px;
  }


  th,
  td {
    padding: 16px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
    font-size: 13px;
  }


  th {
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
  }


  td strong {
    color: #111827;
  }


  .empty {
    text-align: center;
    padding: 45px;
    color: #94a3b8;
  }


  /* Subscriber categories */

  .categories-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    max-width: 230px;
  }


  .category-badge {
    display: inline-block;
    padding: 4px 7px;
    border-radius: 5px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 11px;
    white-space: nowrap;
  }


  .muted-text {
    color: #94a3b8;
  }


  /* Status */

  .badge-status {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }


  .badge-status.success {
    background: #dcfce7;
    color: #166534;
  }


  .badge-status.muted {
    background: #f1f5f9;
    color: #64748b;
  }


  /* Responsive */

  @media (max-width: 1100px) {

    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }


    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }


  @media (max-width: 700px) {

    .sidebar {
      width: 70px;
      padding: 20px 10px;
    }


    .logo {
      font-size: 0;
    }


    .logo span {
      display: none;
    }


    .sidebar nav a,
    .logout-button {
      justify-content: center;
      font-size: 0;
    }


    .sidebar nav a span,
    .logout-button span {
      font-size: 18px;
    }


    .main-content {
      margin-left: 70px;
      width: calc(100% - 70px);
      padding: 25px 18px;
    }


    .topbar {
      align-items: flex-start;
    }


    .stats-grid {
      grid-template-columns: 1fr;
    }


    .category-grid {
      grid-template-columns: 1fr;
    }

  }

</style>