---
import Header from "../../components/Header.astro";
---

<Header />

<div class="admin-layout">
  <!-- =========================
       SIDEBAR
  ========================== -->
  <aside class="sidebar">
    <div class="sidebar-inner">
      <div class="sidebar-menu">
        <a href="/admin" class="menu-item">
          <span class="menu-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
            </svg>
          </span>
          <span>Dashboard</span>
        </a>

        <a href="/admin/jobs" class="menu-item">
          <span class="menu-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="7" width="18" height="13" rx="2"></rect>
              <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              <path d="M3 12h18"></path>
              <path d="M10 12v2h4v-2"></path>
            </svg>
          </span>
          <span>Jobs</span>
        </a>

        <a href="/admin/subscribers" class="menu-item active">
          <span class="menu-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="9" cy="8" r="3"></circle>
              <path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"></path>
              <circle cx="17" cy="9" r="2.5"></circle>
              <path d="M15.5 15.5c2.7.3 4.5 1.8 4.5 4.5"></path>
            </svg>
          </span>
          <span>Subscribers</span>
        </a>

        <a href="/" class="menu-item">
          <span class="menu-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M3 12h18"></path>
              <path d="M12 3c2.2 2.5 3.3 5.5 3.3 9s-1.1 6.5-3.3 9"></path>
              <path d="M12 3c-2.2 2.5-3.3 5.5-3.3 9s1.1 6.5 3.3 9"></path>
            </svg>
          </span>
          <span>View Website</span>
        </a>
      </div>

      <div class="sidebar-bottom">
        <button id="logoutBtn" class="menu-item logout-btn" type="button">
          <span class="menu-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M10 5H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h4"></path>
              <path d="M14 8l4 4-4 4"></path>
              <path d="M18 12H9"></path>
            </svg>
          </span>
          <span>Logout</span>
        </button>
      </div>
    </div>
  </aside>

  <!-- =========================
       MAIN CONTENT
  ========================== -->
  <main class="main-content">
    <!-- PAGE HEADER -->
    <div class="page-header">
      <div class="page-title">
        <div class="title-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="9" cy="8" r="3"></circle>
            <path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"></path>
            <circle cx="17" cy="9" r="2.5"></circle>
            <path d="M15.5 15.5c2.7.3 4.5 1.8 4.5 4.5"></path>
          </svg>
        </div>

        <div>
          <h1>Subscribers</h1>
          <p>Manage and view all JobPortal subscribers.</p>
        </div>
      </div>

      <a href="/admin" class="back-btn">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        <span>Dashboard</span>
      </a>
    </div>

    <!-- =========================
         FILTERS
    ========================== -->
    <section class="filters">
      <div class="search-wrapper">
        <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M16.5 16.5L21 21"></path>
        </svg>

        <input
          id="searchInput"
          type="text"
          placeholder="Search by name, email or phone..."
          autocomplete="off"
        />
      </div>

      <div class="select-wrapper">
        <select id="categoryFilter">
          <option value="">All Categories</option>
          <option value="IT Jobs">IT Jobs</option>
          <option value="Internships">Internships</option>
          <option value="Government Jobs">Government Jobs</option>
          <option value="Private Jobs">Private Jobs</option>
        </select>
      </div>

      <div class="select-wrapper">
        <select id="statusFilter">
          <option value="">All Status</option>
          <option value="Active">Active</option>
          <option value="Inactive">Inactive</option>
        </select>
      </div>

      <button id="clearFilters" class="clear-btn" type="button">
        Clear
      </button>
    </section>

    <!-- =========================
         RESULT INFO
    ========================== -->
    <div class="result-info">
      <strong id="subscriberCount">0</strong>
      <span>subscribers found</span>
    </div>

    <!-- =========================
         TABLE
    ========================== -->
    <section class="table-card">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Categories</th>
              <th>Email</th>
              <th>WhatsApp</th>
              <th>Status</th>
              <th>Joined</th>
            </tr>
          </thead>

          <tbody id="subscriberTable">
            <tr>
              <td colspan="8" class="loading">
                <div class="loading-content">
                  <span class="spinner"></span>
                  <span>Loading subscribers...</span>
                </div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- =========================
         PAGINATION
    ========================== -->
    <div class="pagination">
      <button id="prevBtn" type="button">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
        <span>Previous</span>
      </button>

      <span id="pageInfo">
        Page 1 of 1
      </span>

      <button id="nextBtn" type="button">
        <span>Next</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </main>
</div>

<script>
  // @ts-nocheck

  // ==========================================
  // API BASE URL
  // ==========================================

  const API_URL =
    import.meta.env.PUBLIC_API_URL ||
    "http://localhost:5000";

  // ==========================================
  // STATE
  // ==========================================

  let subscribers = [];
  let filteredSubscribers = [];

  let currentPage = 1;

  const itemsPerPage = 10;

  // ==========================================
  // DOM ELEMENTS
  // ==========================================

  const table =
    document.getElementById("subscriberTable");

  const countElement =
    document.getElementById("subscriberCount");

  const searchInput =
    document.getElementById("searchInput");

  const categoryFilter =
    document.getElementById("categoryFilter");

  const statusFilter =
    document.getElementById("statusFilter");

  const clearFilters =
    document.getElementById("clearFilters");

  const prevBtn =
    document.getElementById("prevBtn");

  const nextBtn =
    document.getElementById("nextBtn");

  const pageInfo =
    document.getElementById("pageInfo");

  const logoutBtn =
    document.getElementById("logoutBtn");

  // ==========================================
  // TOKEN
  // ==========================================

  function getToken() {
    return (
      localStorage.getItem("token") ||
      localStorage.getItem("accessToken")
    );
  }

  // ==========================================
  // LOGOUT
  // ==========================================

  function logout() {
    localStorage.removeItem("token");
    localStorage.removeItem("accessToken");

    window.location.href = "/admin/login";
  }

  if (logoutBtn) {
    logoutBtn.addEventListener(
      "click",
      logout
    );
  }

  // ==========================================
  // INITIAL LOAD
  // ==========================================

  const initialToken = getToken();

  if (!initialToken) {
    window.location.href = "/admin/login";
  } else {
    fetchSubscribers();
  }

  // ==========================================
  // FETCH SUBSCRIBERS
  // ==========================================

  async function fetchSubscribers() {
    try {
      const token = getToken();

      if (!token) {
        window.location.href = "/admin/login";
        return;
      }

      const response = await fetch(
        `${API_URL}/api/subscribers`,
        {
          method: "GET",
          headers: {
            Authorization: `Bearer ${token}`,
            "Content-Type": "application/json",
          },
        }
      );

      // ========================================
      // UNAUTHORIZED / FORBIDDEN
      // ========================================

      if (
        response.status === 401 ||
        response.status === 403
      ) {
        localStorage.removeItem("token");
        localStorage.removeItem("accessToken");

        window.location.href = "/admin/login";
        return;
      }

      // ========================================
      // OTHER API ERRORS
      // ========================================

      if (!response.ok) {
        let errorData = {};

        try {
          errorData = await response.json();
        } catch {
          errorData = {};
        }

        throw new Error(
          errorData.message ||
            `Request failed with status ${response.status}`
        );
      }

      // ========================================
      // SUCCESS
      // ========================================

      const data = await response.json();

      subscribers =
        Array.isArray(data.subscribers)
          ? data.subscribers
          : [];

      filteredSubscribers = [
        ...subscribers,
      ];

      renderTable();
    } catch (error) {
      console.error(
        "Subscriber API Error:",
        error
      );

      const message =
        error instanceof Error
          ? error.message
          : "Something went wrong.";

      if (table) {
        table.innerHTML = `
          <tr>
            <td colspan="8" class="error">
              <div class="error-content">

                <div class="error-icon">
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      cx="12"
                      cy="12"
                      r="9"
                    ></circle>

                    <path
                      d="M12 8v5"
                    ></path>

                    <path
                      d="M12 16h.01"
                    ></path>
                  </svg>
                </div>

                <strong>
                  Failed to load subscribers
                </strong>

                <span>
                  ${escapeHtml(message)}
                </span>

              </div>
            </td>
          </tr>
        `;
      }

      if (countElement) {
        countElement.textContent = "0";
      }
    }
  }

  // ==========================================
  // FILTER + SEARCH
  // ==========================================

  function renderTable() {
    if (
      !searchInput ||
      !categoryFilter ||
      !statusFilter
    ) {
      return;
    }

    const search =
      searchInput.value
        .toLowerCase()
        .trim();

    const category =
      categoryFilter.value;

    const status =
      statusFilter.value;

    filteredSubscribers =
      subscribers.filter(
        (subscriber) => {
          // ------------------------------------
          // SEARCH
          // ------------------------------------

          const name =
            String(
              subscriber.name || ""
            );

          const email =
            String(
              subscriber.email || ""
            );

          const phone =
            String(
              subscriber.phone || ""
            );

          const searchMatch =
            name
              .toLowerCase()
              .includes(search) ||
            email
              .toLowerCase()
              .includes(search) ||
            phone
              .toLowerCase()
              .includes(search);

          // ------------------------------------
          // CATEGORY
          // ------------------------------------

          let categories =
            subscriber.categories || [];

          if (!Array.isArray(categories)) {
            categories = [
              String(categories),
            ];
          }

          const categoryMatch =
            !category ||
            categories.some(
              (item) =>
                String(item)
                  .toLowerCase() ===
                category.toLowerCase()
            );

          // ------------------------------------
          // STATUS
          // ------------------------------------

          const subscriberStatus =
            subscriber.isActive === true
              ? "Active"
              : "Inactive";

          const statusMatch =
            !status ||
            subscriberStatus === status;

          return (
            searchMatch &&
            categoryMatch &&
            statusMatch
          );
        }
      );

    currentPage = 1;

    renderCurrentPage();
  }

  // ==========================================
  // RENDER CURRENT PAGE
  // ==========================================

  function renderCurrentPage() {
    const start =
      (currentPage - 1) *
      itemsPerPage;

    const end =
      start + itemsPerPage;

    const pageSubscribers =
      filteredSubscribers.slice(
        start,
        end
      );

    // ----------------------------------------
    // COUNT
    // ----------------------------------------

    if (countElement) {
      countElement.textContent =
        String(
          filteredSubscribers.length
        );
    }

    // ----------------------------------------
    // EMPTY STATE
    // ----------------------------------------

    if (
      pageSubscribers.length === 0
    ) {
      if (table) {
        table.innerHTML = `
          <tr>
            <td
              colspan="8"
              class="empty"
            >
              <div class="empty-content">

                <div class="empty-icon">
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      cx="9"
                      cy="8"
                      r="3"
                    ></circle>

                    <path
                      d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"
                    ></path>

                    <circle
                      cx="17"
                      cy="9"
                      r="2.5"
                    ></circle>

                    <path
                      d="M15.5 15.5c2.7.3 4.5 1.8 4.5 4.5"
                    ></path>
                  </svg>
                </div>

                <strong>
                  No subscribers found
                </strong>

                <span>
                  Try changing your search or filters.
                </span>

              </div>
            </td>
          </tr>
        `;
      }
    } else {
      // ----------------------------------------
      // TABLE ROWS
      // ----------------------------------------

      const rows =
        pageSubscribers
          .map(
            (subscriber) => {
              const name =
                subscriber.name || "—";

              const email =
                subscriber.email || "—";

              const phone =
                subscriber.phone || "—";

              // --------------------------------
              // CATEGORIES
              // --------------------------------

              let categories =
                subscriber.categories || [];

              if (!Array.isArray(categories)) {
                categories = [
                  String(categories),
                ];
              }

              // --------------------------------
              // OPT-IN
              // --------------------------------

              const emailOptIn =
                subscriber.emailOptIn === true;

              const whatsappOptIn =
                subscriber.whatsappOptIn === true;

              // --------------------------------
              // STATUS
              // --------------------------------

              const status =
                subscriber.isActive === true
                  ? "Active"
                  : "Inactive";

              // --------------------------------
              // DATE
              // --------------------------------

              const formattedDate =
                subscriber.createdAt
                  ? formatDate(
                      subscriber.createdAt
                    )
                  : "—";

              // --------------------------------
              // AVATAR
              // --------------------------------

              const avatar =
                String(name)
                  .trim()
                  .charAt(0)
                  .toUpperCase() || "?";

              // --------------------------------
              // CATEGORY HTML
              // --------------------------------

              const categoryHtml =
                categories.length
                  ? categories
                      .map(
                        (category) => `
                          <span class="category-tag">
                            ${escapeHtml(
                              String(category)
                            )}
                          </span>
                        `
                      )
                      .join("")
                  : `
                      <span class="muted">
                        —
                      </span>
                    `;

              // --------------------------------
              // ROW
              // --------------------------------

              return `
                <tr>

                  <td class="name-cell">
                    <div class="name-wrapper">

                      <span class="avatar">
                        ${escapeHtml(avatar)}
                      </span>

                      <strong>
                        ${escapeHtml(
                          String(name)
                        )}
                      </strong>

                    </div>
                  </td>

                  <td class="email-cell">
                    ${escapeHtml(
                      String(email)
                    )}
                  </td>

                  <td class="phone-cell">
                    ${escapeHtml(
                      String(phone)
                    )}
                  </td>

                  <td>
                    <div class="category-list">
                      ${categoryHtml}
                    </div>
                  </td>

                  <td>
                    <span
                      class="${
                        emailOptIn
                          ? "yes"
                          : "no"
                      }"
                    >
                      <span class="dot"></span>

                      ${
                        emailOptIn
                          ? "Yes"
                          : "No"
                      }
                    </span>
                  </td>

                  <td>
                    <span
                      class="${
                        whatsappOptIn
                          ? "yes"
                          : "no"
                      }"
                    >
                      <span class="dot"></span>

                      ${
                        whatsappOptIn
                          ? "Yes"
                          : "No"
                      }
                    </span>
                  </td>

                  <td>
                    <span
                      class="${
                        status === "Active"
                          ? "status-active"
                          : "status-inactive"
                      }"
                    >
                      <span class="status-dot"></span>

                      ${status}
                    </span>
                  </td>

                  <td class="date-cell">
                    ${formattedDate}
                  </td>

                </tr>
              `;
            }
          )
          .join("");

      if (table) {
        table.innerHTML = rows;
      }
    }

    updatePagination();
  }

  // ==========================================
  // DATE FORMAT
  // ==========================================

  function formatDate(dateString) {
    const date =
      new Date(dateString);

    if (
      Number.isNaN(
        date.getTime()
      )
    ) {
      return "—";
    }

    return date.toLocaleDateString(
      "en-IN",
      {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }
    );
  }

  // ==========================================
  // PAGINATION
  // ==========================================

  function updatePagination() {
    const totalPages =
      Math.max(
        1,
        Math.ceil(
          filteredSubscribers.length /
            itemsPerPage
        )
      );

    if (pageInfo) {
      pageInfo.textContent =
        `Page ${currentPage} of ${totalPages}`;
    }

    if (prevBtn) {
      prevBtn.disabled =
        currentPage === 1;
    }

    if (nextBtn) {
      nextBtn.disabled =
        currentPage === totalPages;
    }
  }

  // ==========================================
  // PREVIOUS PAGE
  // ==========================================

  if (prevBtn) {
    prevBtn.addEventListener(
      "click",
      () => {
        if (currentPage > 1) {
          currentPage--;

          renderCurrentPage();
        }
      }
    );
  }

  // ==========================================
  // NEXT PAGE
  // ==========================================

  if (nextBtn) {
    nextBtn.addEventListener(
      "click",
      () => {
        const totalPages =
          Math.ceil(
            filteredSubscribers.length /
              itemsPerPage
          );

        if (
          currentPage < totalPages
        ) {
          currentPage++;

          renderCurrentPage();
        }
      }
    );
  }

  // ==========================================
  // SEARCH
  // ==========================================

  if (searchInput) {
    searchInput.addEventListener(
      "input",
      () => {
        renderTable();
      }
    );
  }

  // ==========================================
  // CATEGORY FILTER
  // ==========================================

  if (categoryFilter) {
    categoryFilter.addEventListener(
      "change",
      () => {
        renderTable();
      }
    );
  }

  // ==========================================
  // STATUS FILTER
  // ==========================================

  if (statusFilter) {
    statusFilter.addEventListener(
      "change",
      () => {
        renderTable();
      }
    );
  }

  // ==========================================
  // CLEAR FILTERS
  // ==========================================

  if (clearFilters) {
    clearFilters.addEventListener(
      "click",
      () => {
        if (searchInput) {
          searchInput.value = "";
        }

        if (categoryFilter) {
          categoryFilter.value = "";
        }

        if (statusFilter) {
          statusFilter.value = "";
        }

        renderTable();
      }
    );
  }

  // ==========================================
  // SECURITY
  // ==========================================

  function escapeHtml(value) {
    return String(value)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
</script>

<style>
  /* =========================================
     GLOBAL
  ========================================= */
  .admin-layout {
    display: flex;
    min-height: calc(100vh - 70px);
    background: #f6f7fb;
  }

  /* =========================================
     SIDEBAR
  ========================================= */
  .sidebar {
    width: 230px;
    flex-shrink: 0;
    background: #111827;
    min-height: calc(100vh - 70px);
  }

  .sidebar-inner {
    min-height: calc(100vh - 70px);
    display: flex;
    flex-direction: column;
  }

  .sidebar-menu {
    padding: 24px 14px;
  }

  .menu-item {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 15px;
    margin-bottom: 7px;
    border-radius: 10px;
    color: #cbd5e1;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
    cursor: pointer;
  }

  .menu-item:hover {
    background: #1f2937;
    color: #ffffff;
  }

  .menu-item.active {
    background: linear-gradient(
      135deg,
      #4f46e5,
      #5b4bea
    );
    color: #ffffff;
    box-shadow:
      0 6px 18px
      rgba(79, 70, 229, 0.28);
  }

  .menu-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sidebar-bottom {
    margin-top: auto;
    padding: 14px;
  }

  .logout-btn {
    appearance: none;
    border: none;
    background: transparent;
    font-family: inherit;
    text-align: left;
  }

  .logout-btn:hover {
    background: #991b1b;
  }

  /* =========================================
     MAIN CONTENT
  ========================================= */
  .main-content {
    flex: 1;
    min-width: 0;
    padding: 38px 40px 50px;
  }

  /* =========================================
     PAGE HEADER
  ========================================= */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 28px;
  }

  .page-title {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .title-icon {
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    background: #eef2ff;
    color: #4f46e5;
  }

  .title-icon svg {
    width: 25px;
    height: 25px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-header h1 {
    margin: 0 0 5px;
    font-size: 32px;
    line-height: 1.2;
    color: #111827;
    letter-spacing: -0.6px;
  }

  .page-header p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 11px 17px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: #ffffff;
    color: #374151;
    text-decoration: none;
    font-size: 14px;
