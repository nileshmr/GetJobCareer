---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Manage Jobs - JobPortal">
  <div class="jobs-page">
    <div class="page-header">
      <div>
        <h1>Jobs</h1>
        <p>Manage all jobs posted on JobPortal.</p>
      </div>

      <button class="add-btn" id="addJobBtn">+ Add New Job</button>
    </div>

    <div class="filters-card">
      <input
        type="text"
        id="searchInput"
        placeholder="Search by job title or company..."
      />

      <select id="categoryFilter">
        <option value="">All Categories</option>
      </select>

      <select id="jobTypeFilter">
        <option value="">All Job Types</option>
        <option value="Full Time">Full Time</option>
        <option value="Part Time">Part Time</option>
        <option value="Internship">Internship</option>
        <option value="Contract">Contract</option>
        <option value="Freelance">Freelance</option>
      </select>

      <select id="workModeFilter">
        <option value="">All Work Modes</option>
        <option value="On-site">On-site</option>
        <option value="Remote">Remote</option>
        <option value="Hybrid">Hybrid</option>
      </select>

      <select id="statusFilter">
        <option value="">All Status</option>
        <option value="true">Published</option>
        <option value="false">Unpublished</option>
      </select>

      <button id="clearFilters" class="clear-btn">Clear</button>
    </div>

    <div class="jobs-info">
      <h2>All Jobs</h2>
      <span id="jobCount">0 jobs found</span>
    </div>

    <div class="table-card">
      <div class="table-wrapper">
        <table>
          <thead>
            <tr>
              <th>Job</th>
              <th>Company</th>
              <th>Category</th>
              <th>Type</th>
              <th>Work Mode</th>
              <th>Location</th>
              <th>Status</th>
              <th>Created</th>
              <th>Actions</th>
            </tr>
          </thead>

          <tbody id="jobsTableBody">
            <tr>
              <td colspan="9" class="loading">Loading jobs...</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="jobModal">
    <div class="modal">
      <div class="modal-header">
        <div>
          <h2 id="modalTitle">Add New Job</h2>
          <p>Create or update a job posting.</p>
        </div>

        <button type="button" class="close-btn" id="closeModal">×</button>
      </div>

      <form id="jobForm">
        <input type="hidden" id="jobId" />

        <div class="form-grid">
          <div class="form-group full">
            <label for="title">Job Title *</label>
            <input
              type="text"
              id="title"
              required
              placeholder="e.g. MERN Stack Developer Intern"
            />
          </div>

          <div class="form-group">
            <label for="companyName">Company Name *</label>
            <input
              type="text"
              id="companyName"
              required
              placeholder="ABC Technologies"
            />
          </div>

          <div class="form-group">
            <label for="slug">Slug *</label>
            <input
              type="text"
              id="slug"
              required
              placeholder="mern-stack-developer-intern"
            />
          </div>

          <div class="form-group">
            <label for="category">Category *</label>
            <input
              type="text"
              id="category"
              required
              placeholder="IT Jobs"
            />
          </div>

          <div class="form-group">
            <label for="jobType">Job Type</label>
            <select id="jobType">
              <option value="Full Time">Full Time</option>
              <option value="Part Time">Part Time</option>
              <option value="Internship">Internship</option>
              <option value="Contract">Contract</option>
              <option value="Freelance">Freelance</option>
            </select>
          </div>

          <div class="form-group">
            <label for="workMode">Work Mode</label>
            <select id="workMode">
              <option value="On-site">On-site</option>
              <option value="Remote">Remote</option>
              <option value="Hybrid">Hybrid</option>
            </select>
          </div>

          <div class="form-group">
            <label for="location">Location</label>
            <input type="text" id="location" placeholder="Bangalore" />
          </div>

          <div class="form-group">
            <label for="salary">Salary</label>
            <input
              type="text"
              id="salary"
              placeholder="₹20,000 - ₹30,000"
            />
          </div>

          <div class="form-group">
            <label for="experience">Experience</label>
            <input
              type="text"
              id="experience"
              placeholder="0-2 Years"
            />
          </div>

          <div class="form-group">
            <label for="qualification">Qualification</label>
            <input
              type="text"
              id="qualification"
              placeholder="BCA / B.Tech / MCA"
            />
          </div>

          <div class="form-group">
            <label for="companyLogo">Company Logo URL</label>
            <input
              type="url"
              id="companyLogo"
              placeholder="https://..."
            />
          </div>

          <div class="form-group">
            <label for="featuredImage">Featured Image URL</label>
            <input
              type="url"
              id="featuredImage"
              placeholder="https://..."
            />
          </div>

          <div class="form-group full">
            <label for="skills">Skills</label>
            <input
              type="text"
              id="skills"
              placeholder="React, Node.js, MongoDB, Express"
            />
            <small>Separate skills with commas.</small>
          </div>

          <div class="form-group full">
            <label for="description">Description *</label>
            <textarea
              id="description"
              rows="5"
              required
              placeholder="Describe the job..."
            ></textarea>
          </div>

          <div class="form-group full">
            <label for="responsibilities">Responsibilities</label>
            <textarea
              id="responsibilities"
              rows="4"
              placeholder="Develop applications, fix bugs, collaborate with team"
            ></textarea>
            <small>Separate items with commas.</small>
          </div>

          <div class="form-group full">
            <label for="requirements">Requirements</label>
            <textarea
              id="requirements"
              rows="4"
              placeholder="JavaScript knowledge, React experience..."
            ></textarea>
            <small>Separate items with commas.</small>
          </div>

          <div class="form-group full">
            <label for="benefits">Benefits</label>
            <textarea
              id="benefits"
              rows="3"
              placeholder="Certificate, Flexible hours, Work from home"
            ></textarea>
            <small>Separate items with commas.</small>
          </div>

          <div class="form-group">
            <label for="applicationStartDate">Application Start Date</label>
            <input type="date" id="applicationStartDate" />
          </div>

          <div class="form-group">
            <label for="applicationEndDate">Application End Date</label>
            <input type="date" id="applicationEndDate" />
          </div>

          <div class="form-group full">
            <label for="selectionProcess">Selection Process</label>
            <input
              type="text"
              id="selectionProcess"
              placeholder="Online Test, Technical Interview, HR Interview"
            />
            <small>Separate steps with commas.</small>
          </div>

          <div class="form-group full">
            <label for="howToApply">How to Apply</label>
            <textarea
              id="howToApply"
              rows="3"
              placeholder="Click the Apply button and submit your application."
            ></textarea>
          </div>

          <div class="form-group full">
            <label for="applyLink">Apply Link *</label>
            <input
              type="url"
              id="applyLink"
              required
              placeholder="https://company.com/apply"
            />
          </div>

          <div class="form-group">
            <label for="metaTitle">Meta Title</label>
            <input type="text" id="metaTitle" />
          </div>

          <div class="form-group">
            <label for="metaDescription">Meta Description</label>
            <input type="text" id="metaDescription" />
          </div>

          <div class="form-group full">
            <label for="keywords">Keywords</label>
            <input
              type="text"
              id="keywords"
              placeholder="mern jobs, react jobs, developer internship"
            />
          </div>

          <div class="checkbox-group">
            <label>
              <input type="checkbox" id="isPublished" />
              Published
            </label>

            <label>
              <input type="checkbox" id="isFeatured" />
              Featured Job
            </label>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="cancel-btn" id="cancelBtn">
            Cancel
          </button>

          <button type="submit" class="save-btn">
            Save Job
          </button>
        </div>
      </form>
    </div>
  </div>
</Layout>

<script>
  const API_URL = "https://get-job-career.vercel.app/api";

  interface JobImportantDates {
    applicationStartDate?: string;
    applicationEndDate?: string;
  }

  interface Job {
    _id: string;
    title: string;
    companyName: string;
    slug: string;
    category: string;
    jobType: string;
    workMode: string;
    location?: string;
    salary?: string;
    experience?: string;
    qualification?: string;
    companyLogo?: string;
    featuredImage?: string;
    skills?: string[];
    description?: string;
    responsibilities?: string[];
    requirements?: string[];
    benefits?: string[];
    importantDates?: JobImportantDates;
    selectionProcess?: string[];
    howToApply?: string;
    applyLink?: string;
    metaTitle?: string;
    metaDescription?: string;
    keywords?: string[];
    isPublished?: boolean;
    isFeatured?: boolean;
    createdAt?: string;
  }

  interface JobsResponse {
    jobs?: Job[];
    message?: string;
  }

  let jobs: Job[] = [];
  let editingJobId: string | null = null;

  const getElement = <T extends HTMLElement>(id: string): T => {
    const element = document.getElementById(id);

    if (!element) {
      throw new Error(`Element #${id} not found`);
    }

    return element as T;
  };

  const modal = getElement<HTMLDivElement>("jobModal");
  const jobForm = getElement<HTMLFormElement>("jobForm");

  const searchInput =
    getElement<HTMLInputElement>("searchInput");

  const categoryFilter =
    getElement<HTMLSelectElement>("categoryFilter");

  const jobTypeFilter =
    getElement<HTMLSelectElement>("jobTypeFilter");

  const workModeFilter =
    getElement<HTMLSelectElement>("workModeFilter");

  const statusFilter =
    getElement<HTMLSelectElement>("statusFilter");

  const jobsTableBody =
    getElement<HTMLTableSectionElement>("jobsTableBody");

  const jobCount =
    getElement<HTMLSpanElement>("jobCount");

  function getToken(): string | null {
    return localStorage.getItem("token");
  }

  function authHeaders(): HeadersInit {
    const token = getToken();

    return {
      "Content-Type": "application/json",
      Authorization: `Bearer ${token ?? ""}`,
    };
  }

  async function loadJobs(): Promise<void> {
    try {
      const params = new URLSearchParams();

      const search = searchInput.value.trim();
      const category = categoryFilter.value;
      const jobType = jobTypeFilter.value;
      const workMode = workModeFilter.value;
      const status = statusFilter.value;

      if (search) {
        params.append("search", search);
      }

      if (category) {
        params.append("category", category);
      }

      if (jobType) {
        params.append("jobType", jobType);
      }

      if (workMode) {
        params.append("workMode", workMode);
      }

      const queryString = params.toString();

      const response = await fetch(
        `${API_URL}/jobs/admin${queryString ? `?${queryString}` : ""}`,
        {
          headers: authHeaders(),
        }
      );

      const data = (await response.json()) as JobsResponse;

      if (!response.ok) {
        throw new Error(data.message || "Failed to load jobs");
      }

      jobs = Array.isArray(data.jobs) ? data.jobs : [];

      if (status !== "") {
        jobs = jobs.filter(
          (job: Job) =>
            String(Boolean(job.isPublished)) === status
        );
      }

      jobs.sort((a: Job, b: Job) => {
        return (
          new Date(b.createdAt || 0).getTime() -
          new Date(a.createdAt || 0).getTime()
        );
      });

      renderJobs();
      populateFilters();
    } catch (error: unknown) {
      console.error("Load jobs error:", error);

      const message =
        error instanceof Error
          ? error.message
          : "Failed to load jobs";

      jobsTableBody.innerHTML = `
        <tr>
          <td colspan="9" class="error">
            ${escapeHtml(message)}
          </td>
        </tr>
      `;
    }
  }

  function renderJobs(): void {
    jobCount.textContent = `${jobs.length} ${
      jobs.length === 1 ? "job" : "jobs"
    } found`;

    if (!jobs.length) {
      jobsTableBody.innerHTML = `
        <tr>
          <td colspan="9" class="empty">
            No jobs found.
          </td>
        </tr>
      `;

      return;
    }

    jobsTableBody.innerHTML = jobs
      .map((job: Job) => {
        const date = job.createdAt
          ? new Date(job.createdAt).toLocaleDateString("en-IN")
          : "-";

        return `
          <tr>
            <td>
              <div class="job-title">
                ${escapeHtml(job.title)}
              </div>

              ${
                job.isFeatured
                  ? `<span class="featured">Featured</span>`
                  : ""
              }
            </td>

            <td>${escapeHtml(job.companyName)}</td>

            <td>${escapeHtml(job.category)}</td>

            <td>${escapeHtml(job.jobType)}</td>

            <td>${escapeHtml(job.workMode)}</td>

            <td>${escapeHtml(job.location || "-")}</td>

            <td>
              <span class="status ${
                job.isPublished
                  ? "published"
                  : "unpublished"
              }">
                ${
                  job.isPublished
                    ? "Published"
                    : "Unpublished"
                }
              </span>
            </td>

            <td>${date}</td>

            <td>
              <div class="actions">
                <button
                  type="button"
                  class="action edit"
                  data-action="edit"
                  data-id="${escapeHtml(job._id)}"
                >
                  Edit
                </button>

                <button
                  type="button"
                  class="action publish"
                  data-action="publish"
                  data-id="${escapeHtml(job._id)}"
                >
                  ${
                    job.isPublished
                      ? "Unpublish"
                      : "Publish"
                  }
                </button>

                <button
                  type="button"
                  class="action delete"
                  data-action="delete"
                  data-id="${escapeHtml(job._id)}"
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
        `;
      })
      .join("");
  }

  function populateFilters(): void {
    const currentCategory = categoryFilter.value;

    const categories = [
      ...new Set(
        jobs
          .map((job: Job) => job.category)
          .filter(
            (category: string | undefined): category is string =>
              Boolean(category)
          )
      ),
    ].sort();

    categoryFilter.innerHTML =
      `<option value="">All Categories</option>` +
      categories
        .map(
          (category: string) =>
            `<option value="${escapeHtml(category)}">${escapeHtml(
              category
            )}</option>`
        )
        .join("");

    if (
      categories.includes(currentCategory)
    ) {
      categoryFilter.value = currentCategory;
    } else {
      categoryFilter.value = "";
    }
  }

  function openAddModal(): void {
    editingJobId = null;

    getElement<HTMLElement>("modalTitle").textContent =
      "Add New Job";

    jobForm.reset();

    getElement<HTMLSelectElement>("jobType").value =
      "Full Time";

    getElement<HTMLSelectElement>("workMode").value =
      "On-site";

    modal.classList.add("show");
  }

  function openEditModal(job: Job): void {
    editingJobId = job._id;

    getElement<HTMLElement>("modalTitle").textContent =
      "Edit Job";

    getElement<HTMLInputElement>("jobId").value =
      job._id || "";

    getElement<HTMLInputElement>("title").value =
      job.title || "";

    getElement<HTMLInputElement>("companyName").value =
      job.companyName || "";

    getElement<HTMLInputElement>("slug").value =
      job.slug || "";

    getElement<HTMLInputElement>("category").value =
      job.category || "";

    getElement<HTMLSelectElement>("jobType").value =
      job.jobType || "Full Time";

    getElement<HTMLSelectElement>("workMode").value =
      job.workMode || "On-site";

    getElement<HTMLInputElement>("location").value =
      job.location || "";

    getElement<HTMLInputElement>("salary").value =
      job.salary || "";

    getElement<HTMLInputElement>("experience").value =
      job.experience || "";

    getElement<HTMLInputElement>("qualification").value =
      job.qualification || "";

    getElement<HTMLInputElement>("companyLogo").value =
      job.companyLogo || "";

    getElement<HTMLInputElement>("featuredImage").value =
      job.featuredImage || "";

    getElement<HTMLInputElement>("skills").value =
      (job.skills || []).join(", ");

    getElement<HTMLTextAreaElement>("description").value =
      job.description || "";

    getElement<HTMLTextAreaElement>(
      "responsibilities"
    ).value = (job.responsibilities || []).join(", ");

    getElement<HTMLTextAreaElement>(
      "requirements"
    ).value = (job.requirements || []).join(", ");

    getElement<HTMLTextAreaElement>(
      "benefits"
    ).value = (job.benefits || []).join(", ");

    getElement<HTMLInputElement>(
      "applicationStartDate"
    ).value = formatDate(
      job.importantDates?.applicationStartDate
    );

    getElement<HTMLInputElement>(
      "applicationEndDate"
    ).value = formatDate(
      job.importantDates?.applicationEndDate
    );

    getElement<HTMLInputElement>(
      "selectionProcess"
    ).value = (job.selectionProcess || []).join(", ");

    getElement<HTMLTextAreaElement>(
      "howToApply"
    ).value = job.howToApply || "";

    getElement<HTMLInputElement>("applyLink").value =
      job.applyLink || "";

    getElement<HTMLInputElement>("metaTitle").value =
      job.metaTitle || "";

    getElement<HTMLInputElement>(
      "metaDescription"
    ).value = job.metaDescription || "";

    getElement<HTMLInputElement>("keywords").value =
      (job.keywords || []).join(", ");

    getElement<HTMLInputElement>("isPublished").checked =
      Boolean(job.isPublished);

    getElement<HTMLInputElement>("isFeatured").checked =
      Boolean(job.isFeatured);

    modal.classList.add("show");
  }

  function closeModal(): void {
    modal.classList.remove("show");
    editingJobId = null;
  }

  function splitValues(value: string): string[] {
    return value
      .split(",")
      .map((item: string) => item.trim())
      .filter(Boolean);
  }

  function formatDate(
    date: string | undefined
  ): string {
    if (!date) {
      return "";
    }

    const parsedDate = new Date(date);

    if (Number.isNaN(parsedDate.getTime())) {
      return "";
    }

    return parsedDate.toISOString().split("T")[0];
  }

  function buildJobData() {
    const startDate =
      getElement<HTMLInputElement>(
        "applicationStartDate"
      ).value;

    const endDate =
      getElement<HTMLInputElement>(
        "applicationEndDate"
      ).value;

    return {
      title: getElement<HTMLInputElement>(
        "title"
      ).value.trim(),

      companyName: getElement<HTMLInputElement>(
        "companyName"
      ).value.trim(),

      slug: getElement<HTMLInputElement>(
        "slug"
      ).value.trim(),

      category: getElement<HTMLInputElement>(
        "category"
      ).value.trim(),

      jobType:
        getElement<HTMLSelectElement>("jobType").value,

      workMode:
        getElement<HTMLSelectElement>("workMode").value,

      location: getElement<HTMLInputElement>(
        "location"
      ).value.trim(),

      salary: getElement<HTMLInputElement>(
        "salary"
      ).value.trim(),

      experience: getElement<HTMLInputElement>(
        "experience"
      ).value.trim(),

      qualification: getElement<HTMLInputElement>(
        "qualification"
      ).value.trim(),

      companyLogo: getElement<HTMLInputElement>(
        "companyLogo"
      ).value.trim(),

      featuredImage: getElement<HTMLInputElement>(
        "featuredImage"
      ).value.trim(),

      skills: splitValues(
        getElement<HTMLInputElement>("skills").value
      ),

      description: getElement<HTMLTextAreaElement>(
        "description"
      ).value.trim(),

      responsibilities: splitValues(
        getElement<HTMLTextAreaElement>(
          "responsibilities"
        ).value
      ),

      requirements: splitValues(
        getElement<HTMLTextAreaElement>(
          "requirements"
        ).value
      ),

      benefits: splitValues(
        getElement<HTMLTextAreaElement>(
          "benefits"
        ).value
      ),

      importantDates: {
        applicationStartDate:
          startDate || undefined,

        applicationEndDate:
          endDate || undefined,
      },

      selectionProcess: splitValues(
        getElement<HTMLInputElement>(
          "selectionProcess"
        ).value
      ),

      howToApply: getElement<HTMLTextAreaElement>(
        "howToApply"
      ).value.trim(),

      applyLink: getElement<HTMLInputElement>(
        "applyLink"
      ).value.trim(),

      metaTitle: getElement<HTMLInputElement>(
        "metaTitle"
      ).value.trim(),

      metaDescription:
        getElement<HTMLInputElement>(
          "metaDescription"
        ).value.trim(),

      keywords: splitValues(
        getElement<HTMLInputElement>("keywords").value
      ),

      isPublished:
        getElement<HTMLInputElement>(
          "isPublished"
        ).checked,

      isFeatured:
        getElement<HTMLInputElement>(
          "isFeatured"
        ).checked,
    };
  }

  async function saveJob(
    event: SubmitEvent
  ): Promise<void> {
    event.preventDefault();

    try {
      const jobData = buildJobData();

      const url = editingJobId
        ? `${API_URL}/jobs/${editingJobId}`
        : `${API_URL}/jobs`;

      const method = editingJobId
        ? "PUT"
        : "POST";

      const response = await fetch(url, {
        method,
        headers: authHeaders(),
        body: JSON.stringify(jobData),
      });

      const data = (await response.json()) as {
        message?: string;
      };

      if (!response.ok) {
        throw new Error(
          data.message || "Failed to save job"
        );
      }

      alert(
        editingJobId
          ? "Job updated successfully"
          : "Job created successfully"
      );

      closeModal();
      await loadJobs();
    } catch (error: unknown) {
      alert(
        error instanceof Error
          ? error.message
          : "Failed to save job"
      );
    }
  }

  async function togglePublish(
    id: string
  ): Promise<void> {
    try {
      const response = await fetch(
        `${API_URL}/jobs/${id}/publish`,
        {
          method: "PATCH",
          headers: authHeaders(),
        }
      );

      const data = (await response.json()) as {
        message?: string;
      };

      if (!response.ok) {
        throw new Error(
          data.message || "Failed to update status"
        );
      }

      alert(
        data.message || "Job status updated successfully"
      );

      await loadJobs();
    } catch (error: unknown) {
      alert(
        error instanceof Error
          ? error.message
          : "Failed to update status"
      );
    }
  }

  async function deleteJob(
    id: string
  ): Promise<void> {
    const confirmed = confirm(
      "Are you sure you want to delete this job?"
    );

    if (!confirmed) {
      return;
    }

    try {
      const response = await fetch(
        `${API_URL}/jobs/${id}`,
        {
          method: "DELETE",
          headers: authHeaders(),
        }
      );

      const data = (await response.json()) as {
        message?: string;
      };

      if (!response.ok) {
        throw new Error(
          data.message || "Failed to delete job"
        );
      }

      alert("Job deleted successfully");

      await loadJobs();
    } catch (error: unknown) {
      alert(
        error instanceof Error
          ? error.message
          : "Failed to delete job"
      );
    }
  }

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  getElement<HTMLButtonElement>(
    "addJobBtn"
  ).addEventListener(
    "click",
    openAddModal
  );

  getElement<HTMLButtonElement>(
    "closeModal"
  ).addEventListener(
    "click",
    closeModal
  );

  getElement<HTMLButtonElement>(
    "cancelBtn"
  ).addEventListener(
    "click",
    closeModal
  );

  jobForm.addEventListener(
    "submit",
    saveJob
  );

  let searchTimer: ReturnType<
    typeof setTimeout
  > | undefined;

  searchInput.addEventListener(
    "input",
    () => {
      if (searchTimer) {
        clearTimeout(searchTimer);
      }

      searchTimer = setTimeout(
        () => {
          loadJobs();
        },
        400
      );
    }
  );

  categoryFilter.addEventListener(
    "change",
    loadJobs
  );

  jobTypeFilter.addEventListener(
    "change",
    loadJobs
  );

  workModeFilter.addEventListener(
    "change",
    loadJobs
  );

  statusFilter.addEventListener(
    "change",
    loadJobs
  );

  getElement<HTMLButtonElement>(
    "clearFilters"
  ).addEventListener(
    "click",
    () => {
      searchInput.value = "";
      categoryFilter.value = "";
      jobTypeFilter.value = "";
      workModeFilter.value = "";
      statusFilter.value = "";

      loadJobs();
    }
  );

  getElement<HTMLInputElement>(
    "title"
  ).addEventListener(
    "input",
    (event: Event) => {
      if (editingJobId) {
        return;
      }

      const input =
        event.currentTarget as HTMLInputElement;

      const title = input.value;

      const slug = title
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-+|-+$/g, "");

      getElement<HTMLInputElement>(
        "slug"
      ).value = slug;
    }
  );

  jobsTableBody.addEventListener(
    "click",
    (event: MouseEvent) => {
      const target = event.target;

      if (!(target instanceof HTMLElement)) {
        return;
      }

      const button =
        target.closest("button");

      if (!(button instanceof HTMLButtonElement)) {
        return;
      }

      const action =
        button.dataset.action;

      const id =
        button.dataset.id;

      if (!action || !id) {
        return;
      }

      const job =
        jobs.find(
          (item: Job) =>
            item._id === id
        );

      if (
        action === "edit" &&
        job
      ) {
        openEditModal(job);
      }

      if (
        action === "publish"
      ) {
        togglePublish(id);
      }

      if (
        action === "delete"
      ) {
        deleteJob(id);
      }
    }
  );

  modal.addEventListener(
    "click",
    (event: MouseEvent) => {
      if (
        event.target === modal
      ) {
        closeModal();
      }
    }
  );

  loadJobs();
</script>

