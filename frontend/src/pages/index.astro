    </div>

    <a href="/jobs" class="view-all">
      View all jobs →
    </a>
  </div>

  {featuredJobs.length > 0 ? (
    <div class="job-grid">
      {featuredJobs.map((job) => (
        <article class="job-card">
          <div class="job-top">
            {job.companyLogo ? (
              <img
                src={job.companyLogo}
                alt={`${job.companyName} logo`}
                class="company-logo company-logo-image"
                loading="lazy"
              />
            ) : (
              <div class="company-logo">
                {job.companyName.charAt(0).toUpperCase()}
              </div>
            )}

            <div>
              <h3>{job.title}</h3>
              <p>{job.companyName}</p>
            </div>
          </div>

          <div class="job-info">
            <span>
              {job.jobType === "Full Time"
                ? "💼 Full-time"
                : job.jobType === "Part Time"
                  ? "💼 Part-time"
                  : job.jobType === "Internship"
                    ? "🎓 Internship"
                    : `💼 ${job.jobType}`}
            </span>

            <span>
              {job.workMode === "Remote"
                ? "📍 Remote"
