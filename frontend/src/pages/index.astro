---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

interface Job {
  _id: string;
  title: string;
  slug: string;
  companyName: string;
  companyLogo?: string;
  featuredImage?: string;
  category: string;
  jobType: "Full Time" | "Part Time" | "Internship" | "Contract" | "Freelance";
  workMode: "On-site" | "Remote" | "Hybrid";
  location?: string;
  salary?: string;
  experience?: string;
  isPublished: boolean;
  isFeatured: boolean;
}

interface JobsResponse {
  jobs: Job[];
}

const API_URL = import.meta.env.PUBLIC_API_URL || "https://get-job-career.vercel.app";

let featuredJobs: Job[] = [];

try {
  const response = await fetch(`${API_URL}/api/jobs?limit=50`);

  if (response.ok) {
    const data: JobsResponse = await response.json();

    featuredJobs = data.jobs
      .filter((job) => job.isPublished && job.isFeatured)
      .slice(0, 10);
  }
} catch (error) {
  console.error("Failed to fetch featured jobs:", error);
}
---

