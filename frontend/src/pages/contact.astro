---
import Layout from "../layouts/Layout.astro";

const pageTitle =
  "Contact Us | GetJobCareer - Career & Job Support";

const pageDescription =
  "Contact GetJobCareer for questions, feedback, job listing inquiries, partnership opportunities, or career-related support. We are here to help students, freshers, and job seekers.";

const canonicalUrl = "https://getjobcareer.com/contact";

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact GetJobCareer",
  description: pageDescription,
  url: canonicalUrl,
  mainEntity: {
    "@type": "Organization",
    name: "GetJobCareer",
    url: "https://getjobcareer.com",
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "customer support",
      url: canonicalUrl,
      availableLanguage: ["English", "Hindi"],
    },
  },
};
---

<Layout title={pageTitle} description={pageDescription}>
  <main>
    <!-- SEO Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(contactSchema)}
    />

    <!-- Hero Section -->
    <section
      class="hero-section"
      aria-labelledby="contact-page-title"
    >
      <div class="container hero-content">
        <span class="eyebrow">Get In Touch</span>

        <h1 id="contact-page-title">
          Contact GetJobCareer
        </h1>

        <p class="hero-description">
          Have a question, feedback, or need help with something?
          Get in touch with the GetJobCareer team. We are here to
          help students, freshers, job seekers, and employers.
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section
      class="contact-section"
      aria-labelledby="contact-heading"
    >
      <div class="container">

        <div class="contact-grid">

          <!-- Contact Information -->
          <div class="contact-info">

            <span class="section-label">
              Contact Information
            </span>

            <h2 id="contact-heading">
              We'd Love to Hear From You
            </h2>

            <p class="contact-intro">
              Whether you have a question about a job listing,
              want to report an issue, have feedback about our
              website, or are interested in working with us,
              feel free to reach out.
            </p>

            <!-- Email -->
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">
                ✉️
              </div>

              <div>
                <h3>Email Us</h3>
                <p>
                  For general questions and support
                </p>

                <a
                  href="mailto:contact@getjobcareer.com"
                  class="contact-link"
                >
                  contact@getjobcareer.com
                </a>
              </div>
            </div>

            <!-- Job Listings -->
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">
                💼
              </div>

              <div>
                <h3>Job Listing Inquiries</h3>
                <p>
                  Have a job opportunity you'd like to share?
                </p>

                <a
                  href="mailto:jobs@getjobcareer.com"
                  class="contact-link"
                >
                  jobs@getjobcareer.com
                </a>
              </div>
            </div>

            <!-- Partnerships -->
            <div class="contact-item">
              <div class="contact-icon" aria-hidden="true">
                🤝
              </div>

              <div>
                <h3>Partnerships</h3>
                <p>
                  Interested in collaborating with GetJobCareer?
                </p>

                <a
                  href="mailto:partnerships@getjobcareer.com"
                  class="contact-link"
                >
                  partnerships@getjobcareer.com
                </a>
              </div>
            </div>

            <div class="response-box">
              <div class="response-icon" aria-hidden="true">
                ⏱️
              </div>

              <div>
                <strong>We're here to help</strong>
                <p>
                  Send us your message and provide as much detail
                  as possible so we can better understand your
                  request.
                </p>
              </div>
            </div>

          </div>

          <!-- Contact Form -->
          <div class="form-card">

            <div class="form-header">
              <span class="form-label">
                Send a Message
              </span>

              <h2>
                How Can We Help?
              </h2>

              <p>
                Fill out the form below and we'll get back to you.
              </p>
            </div>

            <form
              id="contactForm"
              class="contact-form"
            >

              <!-- Name -->
              <div class="form-group">
                <label for="name">
                  Full Name
                  <span aria-hidden="true">*</span>
                </label>

                <input
                  type="text"
                  id="name"
                  name="name"
                  placeholder="Enter your full name"
                  autocomplete="name"
                  required
                />
              </div>

              <!-- Email -->
              <div class="form-group">
                <label for="email">
                  Email Address
                  <span aria-hidden="true">*</span>
                </label>

                <input
                  type="email"
                  id="email"
                  name="email"
                  placeholder="Enter your email address"
                  autocomplete="email"
                  required
                />
              </div>

              <!-- Subject -->
              <div class="form-group">
                <label for="subject">
                  Subject
                  <span aria-hidden="true">*</span>
                </label>

                <select
                  id="subject"
                  name="subject"
                  required
                >
                  <option value="">
                    Select a subject
                  </option>

                  <option value="General Inquiry">
                    General Inquiry
                  </option>

                  <option value="Job Listing">
                    Job Listing
                  </option>

                  <option value="Feedback">
                    Feedback
                  </option>

                  <option value="Report an Issue">
                    Report an Issue
                  </option>

                  <option value="Partnership">
                    Partnership
                  </option>

                  <option value="Other">
                    Other
                  </option>
                </select>
              </div>

              <!-- Message -->
              <div class="form-group">
                <label for="message">
                  Message
                  <span aria-hidden="true">*</span>
                </label>

                <textarea
                  id="message"
                  name="message"
                  rows="6"
                  placeholder="Write your message here..."
                  required
                ></textarea>
              </div>

              <!-- Submit -->
              <button
                type="submit"
                class="submit-button"
              >
                Send Message
                <span aria-hidden="true">→</span>
              </button>

              <p
                id="formMessage"
                class="form-message"
                aria-live="polite"
              ></p>

            </form>
          </div>

        </div>
      </div>
    </section>

    <!-- Help Section -->
    <section
      class="help-section"
      aria-labelledby="help-heading"
    >
      <div class="container">

        <div class="section-heading">
          <span class="section-label">
            Need Help?
          </span>

          <h2 id="help-heading">
            How Can We Help You?
          </h2>

          <p>
            Find the right way to get in touch with the
            GetJobCareer team based on your request.
          </p>
        </div>

        <div class="help-grid">

          <article class="help-card">
            <div class="help-icon" aria-hidden="true">
              🔎
            </div>

            <h3>
              Job Search Questions
            </h3>

            <p>
              Need help finding relevant job opportunities?
              Explore our job listings and career resources.
            </p>

            <a href="/jobs">
              Browse Jobs →
            </a>
          </article>

          <article class="help-card">
            <div class="help-icon" aria-hidden="true">
              📚
            </div>

            <h3>
              Career Guidance
            </h3>

            <p>
              Learn how to improve your resume, prepare for
              interviews, develop skills, and plan your career.
            </p>

            <a href="/resources">
              Explore Resources →
            </a>
          </article>

          <article class="help-card">
            <div class="help-icon" aria-hidden="true">
              🏢
            </div>

            <h3>
              Employer &amp; Business Inquiries
            </h3>

            <p>
              Companies and organizations can contact us about
              job opportunities, partnerships, and collaborations.
            </p>

            <a href="mailto:partnerships@getjobcareer.com">
              Contact Us →
            </a>
          </article>

        </div>
      </div>
    </section>

    <!-- SEO Content -->
    <section
      class="seo-content-section"
      aria-labelledby="contact-info-heading"
    >
      <div class="container seo-content">

        <span class="section-label">
          GetJobCareer Support
        </span>

        <h2 id="contact-info-heading">
          Contact GetJobCareer for Career and Job Support
        </h2>

        <p>
          GetJobCareer is designed to help students, freshers,
          job seekers, and professionals discover career
          opportunities and access useful job-search resources.
          If you have questions about our website, job listings,
          career guides, or other services, you can contact our
          team through the contact form or email.
        </p>

        <h3>
          Questions About Job Opportunities
        </h3>

        <p>
          If you have questions about a job opportunity listed
          on GetJobCareer, please include the job title, company
          name, and relevant details in your message. Providing
          complete information can help us understand your query
          and respond more effectively.
        </p>

        <h3>
          Feedback and Website Issues
        </h3>

        <p>
          Your feedback helps us improve GetJobCareer. If you
          experience a technical issue, notice incorrect information,
          or have a suggestion for improving the website, please
          let us know through the contact form.
        </p>

        <h3>
          Partnerships and Job Listings
        </h3>

        <p>
          Employers, recruiters, educational organizations, and
          other businesses interested in job listings or
          collaboration can contact our team with details about
          their requirements and opportunity.
        </p>

      </div>
    </section>
  </main>
</Layout>

<script>
  const contactForm =
    document.getElementById("contactForm") as HTMLFormElement | null;

  const formMessage =
    document.getElementById("formMessage");

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    if (formMessage) {
      formMessage.textContent =
        "Thank you for contacting us. Your message has been received.";

      formMessage.classList.add("success");
    }

    contactForm.reset();
  });
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f8fafc;
    color: #0f172a;
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  .container {
    width: min(1180px, calc(100% - 32px));
    margin-inline: auto;
  }

  /* =========================
     HERO
  ========================= */

  .hero-section {
    background:
      linear-gradient(
        180deg,
        #ecfdf5 0%,
        #f8fafc 100%
      );
    border-bottom: 1px solid #e2e8f0;
  }

  .hero-content {
    padding: 72px 0 68px;
    text-align: center;
  }

  .eyebrow,
  .section-label,
  .form-label {
    display: inline-block;
    color: #0f766e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero-content h1 {
    max-width: 800px;
    margin: 12px auto 0;
    color: #0f172a;
    font-size: clamp(34px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    font-weight: 800;
  }

  .hero-description {
    max-width: 720px;
    margin: 20px auto 0;
    color: #64748b;
    font-size: 17px;
    line-height: 1.7;
  }

  /* =========================
     CONTACT
  ========================= */

  .contact-section {
    padding: 75px 0 85px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(0, 1.1fr);
    gap: 70px;
    align-items: start;
  }

  .contact-info h2 {
    margin: 9px 0 15px;
    color: #0f172a;
    font-size: 32px;
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .contact-intro {
    max-width: 560px;
    margin: 0 0 35px;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 0;
    border-bottom: 1px solid #e2e8f0;
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #f0fdfa;
    font-size: 22px;
  }

  .contact-item h3 {
    margin: 1px 0 4px;
    color: #1e293b;
    font-size: 16px;
  }

  .contact-item p {
    margin: 0 0 5px;
    color: #64748b;
    font-size: 13px;
    line-height: 1.5;
  }

  .contact-link {
    color: #0f766e;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    word-break: break-word;
  }

  .contact-link:hover {
    color: #115e59;
    text-decoration: underline;
  }

  .response-box {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    margin-top: 28px;
    padding: 18px;
    border: 1px solid #ccfbf1;
    border-radius: 13px;
    background: #f0fdfa;
  }

  .response-icon {
    font-size: 21px;
  }

  .response-box strong {
    display: block;
    margin-bottom: 4px;
    color: #115e59;
    font-size: 14px;
  }

  .response-box p {
    margin: 0;
    color: #0f766e;
    font-size: 13px;
    line-height: 1.6;
  }

  /* =========================
     FORM
  ========================= */

  .form-card {
    padding: 32px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    box-shadow:
      0 10px 30px rgba(15, 23, 42, 0.05);
  }

  .form-header {
    margin-bottom: 26px;
  }

  .form-header h2 {
    margin: 8px 0 7px;
    color: #0f172a;
    font-size: 25px;
    line-height: 1.3;
  }

  .form-header p {
    margin: 0;
    color: #64748b;
    font-size: 14px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 19px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .form-group label {
    color: #334155;
    font-size: 14px;
    font-weight: 600;
  }

  .form-group label span {
    color: #dc2626;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 9px;
    background: #ffffff;
    color: #0f172a;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .form-group input,
  .form-group select {
    height: 46px;
    padding: 0 13px;
  }

  .form-group textarea {
    min-height: 145px;
    padding: 12px 13px;
    resize: vertical;
    line-height: 1.6;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #94a3b8;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #14b8a6;
    box-shadow:
      0 0 0 3px rgba(20, 184, 166, 0.12);
  }

  .submit-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    min-height: 48px;
    margin-top: 3px;
    padding: 0 20px;
    border: 0;
    border-radius: 10px;
    background:
      linear-gradient(
        135deg,
        #0f766e 0%,
        #047857 100%
      );
    color: #ffffff;
    font-family: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .submit-button:hover {
    transform: translateY(-1px);
    box-shadow:
      0 8px 20px rgba(15, 118, 110, 0.2);
  }

  .submit-button:focus-visible {
    outline: 3px solid rgba(20, 184, 166, 0.25);
    outline-offset: 2px;
  }

  .form-message {
    display: none;
    margin: 0;
    padding: 11px 13px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.5;
  }

  .form-message.success {
    display: block;
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
  }

  /* =========================
     HELP
  ========================= */

  .help-section {
    padding: 75px 0;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 32px;
  }

  .section-heading h2 {
    margin: 9px 0 9px;
    color: #0f172a;
    font-size: 30px;
    line-height: 1.25;
  }

  .section-heading p {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.7;
  }

  .help-grid {
    display: grid;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .help-card {
    padding: 25px;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    background: #f8fafc;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .help-card:hover {
    transform: translateY(-3px);
    border-color: #99f6e4;
    box-shadow:
      0 10px 25px rgba(15, 23, 42, 0.06);
  }

  .help-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    margin-bottom: 17px;
    border-radius: 12px;
    background: #f0fdfa;
    font-size: 23px;
  }

  .help-card h3 {
    margin: 0 0 9px;
    color: #1e293b;
    font-size: 18px;
    line-height: 1.4;
  }

  .help-card p {
    min-height: 72px;
    margin: 0 0 18px;
    color: #64748b;
    font-size: 14px;
    line-height: 1.7;
  }

  .help-card a {
    color: #0f766e;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
  }

  .help-card a:hover {
    color: #115e59;
  }

  /* =========================
     SEO CONTENT
  ========================= */

  .seo-content-section {
    padding: 75px 0 85px;
  }

  .seo-content {
    max-width: 900px;
  }

  .seo-content h2 {
    margin: 9px 0 15px;
    color: #0f172a;
    font-size: 29px;
    line-height: 1.3;
  }

  .seo-content h3 {
    margin: 30px 0 8px;
    color: #1e293b;
    font-size: 20px;
    line-height: 1.4;
  }

  .seo-content p {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.8;
  }

  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .help-grid {
      grid-template-columns:
        repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .container {
      width: min(100% - 24px, 1180px);
    }

    .hero-content {
      padding: 52px 0 50px;
    }

    .hero-content h1 {
      font-size: 34px;
    }

    .hero-description {
      font-size: 15px;
    }

    .contact-section {
      padding: 55px 0;
    }

    .contact-info h2 {
      font-size: 27px;
    }

    .form-card {
      padding: 23px 18px;
      border-radius: 15px;
    }

    .help-section {
      padding: 55px 0;
    }

    .help-grid {
      grid-template-columns: 1fr;
      gap: 15px;
    }

    .help-card p {
      min-height: auto;
    }

    .seo-content-section {
      padding: 55px 0;
    }

    .seo-content h2 {
      font-size: 25px;
    }
  }
</style>