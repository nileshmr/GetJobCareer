<style>
  .faq-section {
    width: 100%;
    padding: 80px 20px;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
  }

  .faq-container {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-heading {
    text-align: center;
    margin-bottom: 42px;
  }

  .faq-badge {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    border-radius: 999px;
    background: #f0fdfa;
    color: #0f766e;
    font-size: 13px;
    font-weight: 700;
  }

  .faq-heading h2 {
    margin: 18px 0 12px;
    color: #0f172a;
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.8px;
  }

  .faq-heading p {
    max-width: 680px;
    margin: 0 auto;
    color: #64748b;
    font-size: 16px;
    line-height: 1.7;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .faq-item {
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .faq-item:hover {
    border-color: #99f6e4;
    box-shadow: 0 5px 18px rgba(15, 23, 42, 0.05);
  }

  .faq-item[open] {
    border-color: #99f6e4;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.06);
  }

  .faq-item summary {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    color: #0f172a;
    font-size: 16px;
    line-height: 1.5;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background: #f0fdfa;
    color: #0f766e;
    font-size: 20px;
    font-weight: 500;
    transition: transform 0.2s ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    padding: 0 22px 21px;
  }

  .faq-answer p {
    margin: 0;
    color: #64748b;
    font-size: 15px;
    line-height: 1.75;
  }

  @media (max-width: 600px) {
    .faq-section {
      padding: 60px 16px;
    }

    .faq-heading {
      margin-bottom: 30px;
    }

    .faq-heading h2 {
      font-size: 2rem;
    }

    .faq-heading p {
      font-size: 15px;
    }

    .faq-item summary {
      padding: 17px;
      font-size: 15px;
    }

    .faq-answer {
      padding: 0 17px 18px;
    }

    .faq-answer p {
      font-size: 14px;
    }
  }
</style>
</Layout>

<script>
  const API_URL = "https://get-job-career.vercel.app/api";

  const searchInput =
    document.getElementById("searchInput") as HTMLInputElement;

  const categoryFilter =
    document.getElementById("categoryFilter") as HTMLSelectElement;

  const jobTypeFilter =
    document.getElementById("jobTypeFilter") as HTMLSelectElement;

  const workModeFilter =
    document.getElementById("workModeFilter") as HTMLSelectElement;

  const locationFilter =
    document.getElementById("locationFilter") as HTMLInputElement;

  const searchButton =
    document.getElementById("searchButton") as HTMLButtonElement;

  const jobsContainer =
    document.getElementById("jobsContainer") as HTMLDivElement;

  const loading =
    document.getElementById("loading") as HTMLDivElement;

  const errorMessage =
    document.getElementById("errorMessage") as HTMLDivElement;

  const emptyMessage =
    document.getElementById("emptyMessage") as HTMLDivElement;

  const resultCount =
    document.getElementById("resultCount") as HTMLSpanElement;

  const pagination =
    document.getElementById("pagination") as HTMLDivElement;

  let currentPage = 1;
  const limit = 9;

  async function loadFilterOptions() {
    try {
      const response = await fetch(
        `${API_URL}/jobs/filters/options`
      );

      if (!response.ok) {
        throw new Error("Failed to load filter options");
      }

      const data = await response.json();

      if (Array.isArray(data.categories)) {
        data.categories.forEach((category: string) => {
          const option = document.createElement("option");
          option.value = category;
          option.textContent = category;
          categoryFilter.appendChild(option);
        });
      }

      if (Array.isArray(data.jobTypes)) {
        data.jobTypes.forEach((jobType: string) => {
          const option = document.createElement("option");
          option.value = jobType;
          option.textContent = jobType;
          jobTypeFilter.appendChild(option);
        });
      }

      if (Array.isArray(data.workModes)) {
        data.workModes.forEach((workMode: string) => {
          const option = document.createElement("option");
          option.value = workMode;
          option.textContent = workMode;
          workModeFilter.appendChild(option);
        });
      }
    } catch (error) {
      console.error("Filter loading error:", error);
    }
  }

  async function loadJobs(page = 1) {
    currentPage = page;

    loading.classList.remove("hidden");
    errorMessage.classList.add("hidden");
    emptyMessage.classList.add("hidden");

    jobsContainer.innerHTML = "";
    pagination.innerHTML = "";

    const params = new URLSearchParams();

    params.set("page", page.toString());
    params.set("limit", limit.toString());

    if (searchInput.value.trim()) {
      params.set("search", searchInput.value.trim());
    }

    if (categoryFilter.value) {
      params.set("category", categoryFilter.value);
    }

    if (jobTypeFilter.value) {
      params.set("jobType", jobTypeFilter.value);
    }

    if (workModeFilter.value) {
      params.set("workMode", workModeFilter.value);
    }

    if (locationFilter.value.trim()) {
      params.set("location", locationFilter.value.trim());
    }

    try {
      const response = await fetch(
        `${API_URL}/jobs?${params.toString()}`
      );

      if (!response.ok) {
        throw new Error("Failed to fetch jobs");
      }

      const data = await response.json();

      loading.classList.add("hidden");

      resultCount.textContent =
        `${data.pagination.totalJobs} ${
          data.pagination.totalJobs === 1
            ? "job"
            : "jobs"
        } found`;

      if (!data.jobs || data.jobs.length === 0) {
        emptyMessage.classList.remove("hidden");
        return;
      }

      data.jobs.forEach((job: any) => {
        const card = createJobCard(job);
        jobsContainer.appendChild(card);
      });

      renderPagination(data.pagination);
    } catch (error) {
      loading.classList.add("hidden");

      errorMessage.textContent =
        "Unable to load jobs. Please try again.";

      errorMessage.classList.remove("hidden");

      console.error("Jobs loading error:", error);
    }
  }

  function createJobCard(job: any) {
    const card = document.createElement("article");

    card.className = "job-card";

    const companyInitial =
      getCompanyInitial(job.companyName);

    const locationHtml = job.location
      ? `
        <span class="job-pill">
          <span class="pill-icon">📍</span>
          <span>${escapeHtml(job.location)}</span>
        </span>
      `
      : "";

    const jobTypeHtml = job.jobType
      ? `
        <span class="job-pill">
          <span class="pill-icon">💼</span>
          <span>${escapeHtml(job.jobType)}</span>
        </span>
      `
      : "";

    const workModeHtml = job.workMode
      ? `
        <span class="job-pill">
          <span class="pill-icon">🏠</span>
          <span>${escapeHtml(job.workMode)}</span>
        </span>
      `
      : "";

    card.innerHTML = `
      <div class="job-card-top">

        <div class="company-logo">
          ${companyInitial}
        </div>

        <div class="company-heading">

          <div class="company-name-top">
            ${escapeHtml(job.companyName || "Company")}
          </div>

          <div class="job-category-mobile">
            ${escapeHtml(job.category || "Job")}
          </div>

        </div>

        <span class="job-category">
          ${escapeHtml(job.category || "Job")}
        </span>

      </div>

      <div class="job-main">

        <h3>
          ${escapeHtml(job.title || "Untitled Job")}
        </h3>

        <p class="company-name">
          ${escapeHtml(job.companyName || "Company")}
        </p>

      </div>

      <div class="job-divider"></div>

      <div class="job-details">
        ${locationHtml}
        ${jobTypeHtml}
        ${workModeHtml}
      </div>

      <div class="job-divider footer-divider"></div>

      <div class="job-card-footer">

        <span class="posted-date">

          <span class="calendar-icon">▣</span>

          ${
            job.createdAt
              ? `Posted ${formatDate(job.createdAt)}`
              : ""
          }

        </span>

        <a
          href="/jobs/${encodeURIComponent(job.slug)}"
          class="view-job"
        >
          <span>View Job</span>
          <span class="arrow">→</span>
        </a>

      </div>
    `;

    return card;
  }

  function renderPagination(data: any) {
    pagination.innerHTML = "";

    if (data.totalPages <= 1) {
      return;
    }

    if (data.hasPreviousPage) {
      const button = document.createElement("button");

      button.className =
        "pagination-button pagination-wide";

      button.innerHTML =
        `<span>←</span><span>Previous</span>`;

      button.addEventListener("click", () => {
        loadJobs(data.currentPage - 1);

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });

      pagination.appendChild(button);
    }

    for (
      let page = 1;
      page <= data.totalPages;
      page++
    ) {
      const button = document.createElement("button");

      button.className = "pagination-button";

      button.textContent = page.toString();

      if (page === data.currentPage) {
        button.classList.add("active");
      }

      button.addEventListener("click", () => {
        loadJobs(page);

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });

      pagination.appendChild(button);
    }

    if (data.hasNextPage) {
      const button = document.createElement("button");

      button.className =
        "pagination-button pagination-wide";

      button.innerHTML =
        `<span>Next</span><span>→</span>`;

      button.addEventListener("click", () => {
        loadJobs(data.currentPage + 1);

        window.scrollTo({
          top: 0,
          behavior: "smooth"
        });
      });

      pagination.appendChild(button);
    }
  }

  function getCompanyInitial(name: string) {
    if (!name) {
      return "C";
    }

    return name.charAt(0).toUpperCase();
  }

  function formatDate(date: string) {
    if (!date) {
      return "";
    }

    return new Date(date).toLocaleDateString(
      "en-IN",
      {
        day: "numeric",
        month: "short",
        year: "numeric"
      }
    );
  }

  function escapeHtml(value: any) {
    const div = document.createElement("div");

    div.textContent = String(value);

    return div.innerHTML;
  }

  searchButton.addEventListener("click", () => {
    loadJobs(1);
  });

  searchInput.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      loadJobs(1);
    }
  });

  categoryFilter.addEventListener("change", () => {
    loadJobs(1);
  });

  jobTypeFilter.addEventListener("change", () => {
    loadJobs(1);
  });

  workModeFilter.addEventListener("change", () => {
    loadJobs(1);
  });

  locationFilter.addEventListener("keydown", (event) => {
    if (event.key === "Enter") {
      loadJobs(1);
    }
  });

  loadFilterOptions();
  loadJobs();
</script>



