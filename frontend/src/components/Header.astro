<header class="site-header">
  <div class="header-container">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="GetJobCareer Home">
      <span class="logo-icon">💼</span>

      <span class="logo-text">
        GetJob<span>Career</span>
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main navigation">

      <a href="/" class="nav-link">
        Home
      </a>

      <a href="/jobs" class="nav-link">
        Jobs & Internships
      </a>

      <a href="/subscribe" class="nav-link">
        Subscribe <span class="bell">🔔</span>
      </a>

      <a href="/resources" class="nav-link">
        Resources
      </a>

      <a href="/about" class="nav-link">
        About
      </a>

      <a href="/jobs" class="browse-btn">
        Browse Jobs
      </a>

    </nav>

    <!-- Mobile Menu Button -->
    <button
      class="menu-btn"
      id="menuBtn"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobileMenu"
    >
      <span class="menu-icon">☰</span>
      <span class="close-icon">✕</span>
    </button>

  </div>

  <!-- Mobile Navigation -->
  <div class="mobile-menu" id="mobileMenu">

    <a href="/" class="mobile-nav-link">
      <span>Home</span>
    </a>

    <a href="/jobs" class="mobile-nav-link">
      <span>Jobs & Internships</span>
    </a>

    <a href="/subscribe" class="mobile-nav-link">
      <span>Subscribe 🔔</span>
    </a>

    <a href="/resources" class="mobile-nav-link">
      <span>Resources</span>
    </a>

    <a href="/about" class="mobile-nav-link">
      <span>About</span>
    </a>

    <a href="/jobs" class="mobile-browse-btn">
      Browse Jobs
      <span>→</span>
    </a>

  </div>
</header>


<style>
  /* ================================
     HEADER
  ================================= */

  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid #e2e8f0;
  }

  .header-container {
    width: 100%;
    max-width: 1280px;
    height: 68px;
    margin: 0 auto;
    padding: 0 24px;

    display: flex;
    align-items: center;
    justify-content: space-between;
  }


  /* ================================
     LOGO
  ================================= */

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: linear-gradient(
      135deg,
      #14b8a6,
      #059669
    );

    font-size: 18px;

    box-shadow:
      0 3px 10px rgba(16, 185, 129, 0.18);
  }

  .logo-text {
    color: #0f172a;
    font-size: 21px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.5px;
  }

  .logo-text span {
    color: #0d9488;
  }


  /* ================================
     DESKTOP NAV
  ================================= */

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;

    padding: 9px 14px;
    border-radius: 9px;

    color: #475569;
    background: transparent;

    text-decoration: none;

    font-size: 14px;
    font-weight: 600;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  /* Normal Hover */
  .nav-link:hover {
    color: #0f172a;
    background: #f1f5f9;
  }

  /* ================================
     ACTIVE NAV LINK
  ================================= */

  .nav-link.active {
    color: #0f766e;
    background: #f0fdfa;
  }

  .nav-link.active:hover {
    color: #0f766e;
    background: #ccfbf1;
  }

  .bell {
    font-size: 13px;
  }


  /* ================================
     BROWSE BUTTON
  ================================= */

  .browse-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-left: 10px;

    min-height: 40px;
    padding: 0 18px;

    border-radius: 9px;

    color: #ffffff;

    background: linear-gradient(
      135deg,
      #14b8a6,
      #059669
    );

    text-decoration: none;

    font-size: 14px;
    font-weight: 700;

    box-shadow:
      0 4px 12px rgba(5, 150, 105, 0.18);

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .browse-btn:hover {
    background: linear-gradient(
      135deg,
      #0d9488,
      #047857
    );

    transform: translateY(-1px);

    box-shadow:
      0 7px 16px rgba(5, 150, 105, 0.25);
  }


  /* ================================
     MOBILE MENU BUTTON
  ================================= */

  .menu-btn {
    display: none;

    width: 42px;
    height: 42px;

    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 10px;

    background: transparent;
    color: #334155;

    font-size: 23px;

    cursor: pointer;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .menu-btn:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .close-icon {
    display: none;
  }


  /* ================================
     MOBILE MENU
  ================================= */

  .mobile-menu {
    display: none;

    max-width: 1280px;

    margin: 0 auto;

    padding: 8px 24px 18px;

    border-top: 1px solid #f1f5f9;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;

    width: 100%;

    padding: 12px 14px;
    margin-top: 3px;

    border-radius: 9px;

    color: #475569;
    background: transparent;

    text-decoration: none;

    font-size: 15px;
    font-weight: 600;

    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .mobile-nav-link:hover {
    color: #0f766e;
    background: #f0fdfa;
  }

  /* Mobile Active Link */

  .mobile-nav-link.active {
    color: #0f766e;
    background: #f0fdfa;
  }

  .mobile-nav-link.active:hover {
    color: #0f766e;
    background: #ccfbf1;
  }


  /* ================================
     MOBILE BROWSE BUTTON
  ================================= */

  .mobile-browse-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-top: 9px;

    padding: 12px 15px;

    border-radius: 9px;

    color: white;

    text-decoration: none;

    background: linear-gradient(
      135deg,
      #14b8a6,
      #059669
    );

    font-size: 15px;
    font-weight: 700;

    box-shadow:
      0 4px 12px rgba(5, 150, 105, 0.18);
  }


  /* ================================
     TABLET
  ================================= */

  @media (max-width: 950px) {

    .header-container {
      padding: 0 20px;
    }

    .desktop-nav {
      gap: 0;
    }

    .nav-link {
      padding: 8px 9px;
      font-size: 13px;
    }

    .browse-btn {
      margin-left: 6px;
      padding: 0 14px;
      font-size: 13px;
    }

  }


  /* ================================
     MOBILE
  ================================= */

  @media (max-width: 768px) {

    .header-container {
      height: 64px;
      padding: 0 16px;
    }

    .desktop-nav {
      display: none;
    }

    .menu-btn {
      display: flex;
    }

    .logo-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      font-size: 17px;
    }

    .logo-text {
      font-size: 20px;
    }

    .mobile-menu.open {
      display: block;
    }

    .menu-btn.open .menu-icon {
      display: none;
    }

    .menu-btn.open .close-icon {
      display: block;
    }

  }


  /* ================================
     SMALL MOBILE
  ================================= */

  @media (max-width: 400px) {

    .header-container {
      padding: 0 13px;
    }

    .logo-text {
      font-size: 18px;
    }

    .logo-icon {
      width: 34px;
      height: 34px;
      font-size: 16px;
    }

    .mobile-menu {
      padding-left: 13px;
      padding-right: 13px;
    }

  }
</style>


<script>
  /* =================================
     MOBILE MENU FUNCTIONALITY
  ================================= */

  const menuBtn = document.getElementById("menuBtn");
  const mobileMenu = document.getElementById("mobileMenu");

  if (menuBtn && mobileMenu) {

    menuBtn.addEventListener("click", () => {

      const isOpen = menuBtn.classList.toggle("open");

      mobileMenu.classList.toggle("open", isOpen);

      menuBtn.setAttribute(
        "aria-expanded",
        String(isOpen)
      );

      menuBtn.setAttribute(
        "aria-label",
        isOpen
          ? "Close navigation menu"
          : "Open navigation menu"
      );

    });


    mobileMenu
      .querySelectorAll("a")
      .forEach((link) => {

        link.addEventListener("click", () => {

          menuBtn.classList.remove("open");

          mobileMenu.classList.remove("open");

          menuBtn.setAttribute(
            "aria-expanded",
            "false"
          );

          menuBtn.setAttribute(
            "aria-label",
            "Open navigation menu"
          );

        });

      });

  }


  /* =================================
     ACTIVE NAVIGATION
  ================================= */

  const currentPath = window.location.pathname;

  const desktopLinks =
    document.querySelectorAll(".desktop-nav .nav-link");

  const mobileLinks =
    document.querySelectorAll(".mobile-nav-link");


  function setActiveLink(
    links: NodeListOf<HTMLAnchorElement>
  ) {

    links.forEach((link) => {

      const href = link.getAttribute("href");

      if (!href) return;


      let isActive = false;


      /* Home */
      if (href === "/") {

        isActive =
          currentPath === "/" ||
          currentPath === "";

      }


      /* Other pages */
      else {

        isActive =
          currentPath === href ||
          currentPath.startsWith(href + "/");

      }


      if (isActive) {

        link.classList.add("active");

        link.setAttribute(
          "aria-current",
          "page"
        );

      }

    });

  }


  setActiveLink(desktopLinks as NodeListOf<HTMLAnchorElement>);

  setActiveLink(mobileLinks as NodeListOf<HTMLAnchorElement>);
</script>