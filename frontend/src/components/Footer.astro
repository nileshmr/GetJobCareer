  </div>
</footer>

<style>
  .footer {
    background: #0f172a;
    color: #cbd5e1;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 5% 25px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 50px;
  }

  .footer-brand {
    max-width: 430px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #ffffff;
    font-size: 24px;
    font-weight: 800;
    margin-bottom: 18px;
  }

  .brand-icon {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #4f46e5, #7c3aed);
    font-size: 20px;
  }

  .brand-accent {
    color: #818cf8;
  }

  .footer-brand p {
    color: #94a3b8;
    font-size: 14px;
    line-height: 1.8;
    margin: 0;
    max-width: 390px;
  }

  .social-links {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 10px;
    border-radius: 10px;
    background: #1e293b;
    border: 1px solid #334155;
    color: #94a3b8;
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    background: #4f46e5;
    border-color: #4f46e5;
    color: #ffffff;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-column h3 {
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    margin: 0 0 8px;
  }

  .footer-column a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }

  .footer-column a:hover {
    color: #818cf8;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    border-top: 1px solid #1e293b;
    margin-top: 50px;
    padding-top: 24px;
  }

  .footer-bottom p {
    color: #64748b;
    font-size: 13px;
    margin: 0;
  }

  .footer-legal {
    display: flex;
    gap: 25px;
  }

  .footer-legal a {
    color: #64748b;
    text-decoration: none;
    font-size: 13px;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: #818cf8;
  }

  @media (max-width: 900px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }

    .footer-brand {
      grid-column: span 2;
      max-width: 600px;
    }
  }

  @media (max-width: 600px) {
    .footer-container {
      padding: 45px 6% 22px;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 35px 25px;
    }

    .footer-brand {
      grid-column: span 2;
    }

    .footer-bottom {
      flex-direction: column;
      text-align: center;
    }

    .footer-legal {
      gap: 18px;
    }
  }

  @media (max-width: 420px) {
    .footer-main {
      grid-template-columns: 1fr;
    }

    .footer-brand {
      grid-column: span 1;
    }
  }
</style>
