  </div>

  <div class="footer-column">
    <h3>Job Categories</h3>
    <a href="/jobs?category=IT%20Jobs">IT Jobs</a>
    <a href="/jobs?category=Internships">Internships</a>
    <a href="/jobs?category=Government%20Jobs">Government Jobs</a>
